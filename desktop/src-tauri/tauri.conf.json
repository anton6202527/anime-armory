{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnimeArmory",
  "version": "0.1.30",
  "identifier": "com.animearmory.desktop",
  "build": {
    "beforeDevCommand": "node sync-skills.cjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node sync-skills.cjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnimeArmory",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
