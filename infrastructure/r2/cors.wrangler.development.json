{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "methods": [
          "GET",
          "PUT"
        ],
        "headers": [
          "Content-Type",
          "x-amz-meta-asset-id",
          "x-amz-meta-project-id",
          "x-amz-meta-owner-account-id"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
