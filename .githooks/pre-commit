#!/usr/bin/env bash
# 提交前快子集回归闸门（pre-commit fast gate）。
#
# 本仓库提交直推 main、且后台 factory 进程会自动 commit WIP——CI 在云端，反馈慢。
# 这个钩子在本机提交前先跑一遍"改动目录测试 + 治理 + 独立性"，几秒内挡住最高频的
# 静默失效（契约改动废下游、README 索引漏同步、跨线 import）。
#
# 安装（一次性，仓库内已检入钩子，只需把 git 指向它）：
#   git config core.hooksPath .githooks
#
# 临时跳过（紧急提交）：  git commit --no-verify
# 完整全量请用 CI 或：    bash tools/run_all_checks.sh
set -uo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
exec bash "$REPO_ROOT/tools/run_all_checks.sh" --changed
