{
  "name": "anime-armory-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "LabuTV application monorepo and shared cloud foundation.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace @anime-armory/backend",
    "dev:backend:local": "node scripts/dev-backend-local-supabase.mjs",
    "test:dev-backend:local": "node --test scripts/test-dev-backend-local-supabase.mjs",
    "start:backend": "npm run start --workspace @anime-armory/backend",
    "test:backend": "npm run test --workspace @anime-armory/backend",
    "dev:desktop": "npm run dev --workspace @anime-armory/desktop",
    "dev:web": "npm run dev --workspace @anime-armory/web",
    "build:desktop": "npm run build --workspace @anime-armory/desktop && npm run verify:desktop-bundle",
    "build:web": "npm run build --workspace @anime-armory/web",
    "check:vscode": "npm run check --workspace apps/vscode-extension",
    "sync:vscode": "npm run sync-assets --workspace apps/vscode-extension",
    "package:vscode": "npm run package --workspace apps/vscode-extension",
    "verify:desktop-bundle": "node scripts/verify_renderer_dependencies.mjs",
    "typecheck:desktop": "npm run typecheck --workspace @anime-armory/desktop",
    "typecheck:web": "npm run typecheck --workspace @anime-armory/web",
    "typecheck:cloud": "npm run typecheck --workspace @anime-armory/contracts --workspace @anime-armory/cloud-client --workspace @anime-armory/data-access --workspace @anime-armory/object-store",
    "typecheck:edge": "npm run typecheck --workspace @anime-armory/backend",
    "typecheck:cloud-e2e": "tsc -p scripts/tsconfig.cloud.json",
    "test:cloud": "npm run test --workspace @anime-armory/contracts --workspace @anime-armory/cloud-client --workspace @anime-armory/data-access --workspace @anime-armory/object-store",
    "test:demos": "node --test scripts/test_demo_assets.mjs",
    "demos:build": "node scripts/publish_demos_r2.mjs",
    "demos:publish": "node scripts/publish_demos_r2.mjs --publish",
    "test:cloud:remote": "tsx scripts/cloud_e2e.ts",
    "check:cloud": "npm run typecheck:cloud && npm run typecheck:edge && npm run typecheck:cloud-e2e && npm run test:cloud",
    "check": "npm run check:cloud && npm run test:demos && npm run typecheck:desktop && npm run check:vscode",
    "supabase": "supabase --workdir apps/backend"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@types/node": "24.10.1",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "yazl": "^3.3.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents": false,
    "node-pty@1.1.0": true
  },
  "engines": {
    "node": ">=20"
  }
}
