{
  "kind": "n2d_gate_policy_matrix",
  "version": 1,
  "rule": "Gate policy is data. Gate scripts execute checks; this matrix declares family, human boundary, trace policy and required check groups.",
  "stages": {
    "image_prompt_preflight": {
      "family": "image_prompt_preflight",
      "human_boundary": "agent_generation",
      "trace_policy": "recommended",
      "required_check_groups": ["compliance", "progress", "voice_timing", "storyboard_contract", "style_contract", "special_templates", "story_economy", "production_handoff", "skill_freshness"]
    },
    "image_preflight": {
      "family": "image",
      "human_boundary": "paid_or_irreversible",
      "trace_policy": "required_for_batch",
      "required_check_groups": ["compliance", "progress", "identity_registry", "asset_registry", "storyboard_contract", "story_economy", "production_handoff", "production_locks", "retention", "budget", "backend_evidence", "skill_freshness"]
    },
    "image": {
      "family": "image",
      "human_boundary": "post_generation_qc",
      "trace_policy": "required",
      "required_check_groups": ["story_economy", "production_handoff", "image_qc", "consistency_audit", "generation_recipe", "seed_events", "contract_inheritance"]
    },
    "video_prompt_preflight": {
      "family": "video_prompt_preflight",
      "human_boundary": "agent_generation",
      "trace_policy": "recommended",
      "required_check_groups": ["compliance", "progress", "story_economy", "production_handoff", "production_locks", "identity_handoff", "asset_handoff", "image_qc", "model_router", "motion_contract", "skill_freshness"]
    },
    "video_preflight": {
      "family": "video",
      "human_boundary": "paid_or_irreversible",
      "trace_policy": "required_for_batch",
      "required_check_groups": ["compliance", "progress", "story_economy", "production_handoff", "production_locks", "identity_handoff", "asset_handoff", "image_qc", "video_routes", "budget", "backend_evidence", "skill_freshness"]
    },
    "video": {
      "family": "video",
      "human_boundary": "post_generation_qc",
      "trace_policy": "required",
      "required_check_groups": ["story_economy", "production_handoff", "video_assets", "consistency_audit", "generation_recipe", "contract_inheritance", "semantic_lineage"]
    },
    "compose": {
      "family": "compose",
      "human_boundary": "paid_or_irreversible",
      "trace_policy": "required",
      "required_check_groups": ["compliance", "progress", "compose_inputs", "subtitle_alignment", "voice_identity", "consistency_audit", "retention"]
