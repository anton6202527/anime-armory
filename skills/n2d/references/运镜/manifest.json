{
  "schema_version": 1,
  "updated_at": "2026-07-10",
  "name": "n2d camera movement manifest",
  "purpose": "为 n2d-script 的导演运镜 sidecar 和 n2d-video 的视频 prompt 提供结构化运镜候选。视觉参考图只做理解校准；真正提交给视频后端时仍使用结构化字段：运镜词、速度、方向、起幅、落幅、风险降级。",
  "source_summary": "现有 23 个用户提供 animated WebP 已绑定媒体；另补 10 个高价值影视/AI 视频常用镜头控制项，暂无视觉参考图。",
  "sources": [
    {
      "name": "StudioBinder camera movement guide",
      "url": "https://www.studiobinder.com/blog/different-types-of-camera-movements-in-film/",
      "used_for": "传统影视运镜分类：pan, tilt, zoom, dolly, tracking, arc, roll, handheld, aerial 等。"
    },
    {
      "name": "Storyblocks basic camera movements",
      "url": "https://www.storyblocks.com/resources/tutorials/7-basic-camera-movements",
      "used_for": "基础轴向：zoom, pan, tilt, dolly, truck, pedestal, rack focus。"
    },
    {
      "name": "Kling AI camera control guide",
      "url": "https://kling.ai/quickstart/ai-camera-control-guide",
      "used_for": "AI 视频控制口径：水平/垂直/变焦/摇/倾斜/滚转及组合控制。"
    },
    {
      "name": "Runway camera control documentation",
      "url": "https://help.runwayml.com/hc/en-us/articles/34926468947347-Creating-with-Camera-Control-on-Gen-3-Alpha-Turbo",
      "used_for": "AI 视频提示词与相机控制配合方式。"
    }
  ],
  "selection_policy": {
    "default_safe_moves": ["固定机位", "推镜头", "拉镜头", "移镜头", "跟拍"],
    "identity_risk_downgrade": "近景大表情、对白反打、角色身份不稳时，优先降级为固定机位、轻微推镜头、稳定器低幅跟拍或 OTS/物件反应镜。",
    "high_motion_rule": "打斗、追逐、飞行、载具、多人接触镜头先保证动作/身份/接缝，再决定是否使用强运镜；必要时拆 Clip 或走 Motion Control。",
    "prompt_rule": "每条镜头运动必须补 speed、direction、start_frame、end_frame；只写运镜名不够。"
  },
