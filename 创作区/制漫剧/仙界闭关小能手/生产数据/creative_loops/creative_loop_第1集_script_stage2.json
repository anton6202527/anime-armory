{
  "action_contract": {
    "owner": "n2d-script",
    "paid_or_irreversible": false,
    "prework_steps": [
      "source_check",
      "update_plan",
      "doctor"
    ],
    "requires_context_pack": true,
    "requires_creative_loop": true,
    "requires_human_approval": false,
    "requires_trace": true,
    "schema_version": 1,
    "specialist": "n2d-script-agent",
    "stage_key": "script_stage2",
    "stop_policy": "needs_agent_gen",
    "supervisor_contract": {
      "may_auto_run_deterministic_prework": true,
      "may_call_specialist": true,
      "may_change_backend_without_adapter": false,
      "may_execute_paid_work": false,
      "may_write_progress_without_stage_verification": false
    }
  },
  "episode": "第1集",
  "kind": "n2d_creative_loop_packet",
  "loop": [
    {
      "instruction": "使用 context_pack 生成本阶段候选产物；不得越过花钱/合规/进度回写边界。",
      "owner": "n2d-script-agent",
      "step": "generate"
    },
    {
      "output": "列 block/warn/info；block 必须给 return_to_stage 和最小修复范围。",
      "owner": "n2d-script-agent",
      "rubric": [
        "storyboard 是否把台词/动作/镜头时长拆到可执行 Clip",
        "高风险镜头是否套专项模板和 template_contract",
        "镜头是否有景别阶梯、轴线、状态转场和素材清单闭环"
      ],
      "step": "evaluate"
    },
    {
      "instruction": "只修本阶段产物和直接依赖，不重写无关集/无关资产；保留可追溯 diff 摘要。",
      "owner": "n2d-script-agent",
      "step": "optimize"
    },
    {
      "instruction": "通过 gate 后再交给用户确认；进度回写仍走对应 stage skill/contract。",
      "owner": "n2d-supervisor",
      "step": "finalize"
    }
  ],
  "max_iterations": 2,
  "root": "创作区/制漫剧/仙界闭关小能手",
  "stage_key": "script_stage2",
  "stop_conditions": [
    "gate/prework block",
    "requires human approval",
    "paid_or_irreversible action",
    "no material improvement after 2 iterations"
  ],
  "version": 1
}
