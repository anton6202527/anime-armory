{
  "kind": "n2d_consistency_policy_lattice",
  "version": 1,
  "priority_order": [
    "fixed_mode",
    "compliance_capability_evidence",
    "native_voice_fallback",
    "identity_affinity",
    "identity_failure_escalation",
    "motion_control_required",
    "frame_anchor_required",
    "cross_episode_baseline",
    "spectacle_benchmark",
    "spectacle_prior",
    "cost_quality_tier",
    "motion_reference_advisory",
    "multishot_advisory"
  ],
  "policies": [
    {
      "policy": "fixed_mode",
      "priority": 0,
      "description": "用户显式固定模型时，项目设置优先于自动路由、先验和 benchmark。"
    },
    {
      "policy": "compliance_capability_evidence",
      "priority": 1,
      "description": "合规、授权和后端硬能力证据优先，缺能力不得用低优先级策略绕过。"
    },
    {
      "policy": "native_voice_fallback",
      "priority": 2,
      "description": "原生音画的说话镜若无法保证声纹一致，先回退 voice-first 或要求补声纹证据。"
    },
    {
      "policy": "identity_affinity",
      "priority": 3,
      "description": "一角一后端亲和/已注册主体优先于跨集 shot_type 基线。"
    },
    {
      "policy": "identity_failure_escalation",
      "priority": 4,
      "description": "身份漂移反复失败时升级锁定强度，优先于成本和快慢档。"
    },
    {
      "policy": "motion_control_required",
      "priority": 5,
      "description": "高风险动作镜的运动控制/拆招契约优先于普通质量档。"
    },
    {
      "policy": "frame_anchor_required",
      "priority": 6,
      "description": "首尾/中帧锚是物理和表情保真的执行契约，不得被 ROI 直接取消。"
    },
    {
      "policy": "cross_episode_baseline",
      "priority": 7,
      "description": "跨集后端基线稳定画风；低于身份亲和，高于 benchmark/先验。"
    },
    {
      "policy": "spectacle_benchmark",
      "priority": 8,
      "description": "小样 probe 的奇观后端推荐可覆盖自动兜底，但不得覆盖更高优先级锁定。"
    },
    {
      "policy": "spectacle_prior",
      "priority": 9,
      "description": "冷启动动作先验只修正通用兜底，不能覆盖已定稿策略。"
    },
    {
      "policy": "cost_quality_tier",
      "priority": 10,
      "description": "成本/速度/质量档只在不破坏一致性契约时生效。"
    },
    {
      "policy": "motion_reference_advisory",
      "priority": 11,
      "description": "运动参考库是增强项，缺失时降级为风险提醒。"
    },
    {
      "policy": "multishot_advisory",
      "priority": 12,
      "description": "多镜单次生成是建议项，跨项目统一切换前不自动改主路由。"
    }
  ],
  "rule": "lower priority number wins when policies compete for the same routing or consistency surface",
  "conflict_surfaces": {
    "backend_choice": [
      "fixed_mode",
      "identity_affinity",
      "cross_episode_baseline",
      "spectacle_benchmark",
      "spectacle_prior",
      "cost_quality_tier"
    ],
    "voice_identity": [
      "compliance_capability_evidence",
      "native_voice_fallback",
      "cost_quality_tier"
    ],
    "frame_contract": [
      "identity_failure_escalation",
      "motion_control_required",
      "frame_anchor_required",
      "cost_quality_tier"
    ],
    "style_grade": [
      "cross_episode_baseline",
      "cost_quality_tier"
    ]
  }
}
