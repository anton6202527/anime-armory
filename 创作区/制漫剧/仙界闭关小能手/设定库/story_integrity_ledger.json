          "shot": 2,
          "role": "张老大",
          "tags": [
            "texture"
          ],
          "text": "你叫贺平生？多大了？"
        },
        {
          "shot": 3,
          "role": "贺平生",
          "tags": [
            "texture"
          ],
          "text": "回张老大的话，我今年十四岁。"
        },
        {
          "shot": 4,
          "role": "张老大",
          "tags": [
            "texture"
          ],
          "text": "什么灵根？"
