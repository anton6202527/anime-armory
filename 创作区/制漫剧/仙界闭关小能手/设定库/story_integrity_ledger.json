        {
          "shot": 2,
          "role": "旁白",
          "tags": [
            "texture"
          ],
          "text": "那只昨夜还黑乎乎的破陶盆，此刻盆底正有一缕微光，缓缓游动。"
        },
        {
          "shot": 3,
          "role": "贺平生",
          "tags": [
            "texture"
          ],
          "text": "这……"
