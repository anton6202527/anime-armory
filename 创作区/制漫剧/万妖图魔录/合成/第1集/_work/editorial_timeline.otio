                "subtitle_text": "你…… 集尾"
              }
            },
            "name": "你…… 集尾"
          }
        ],
        "metadata": {
          "n2d": {
            "track_role": "V1 Picture"
          }
        },
        "name": "V1 Picture",
        "source_range": null
      },
      {
        "OTIO_SCHEMA": "Track.1",
        "children": [
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 1,
                "media_status": "planned_missing_reference",
                "role": "虎妖",
                "text": "别跑了……这荒郊野岭的，你们想去哪儿？ 钩子",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_001_虎妖",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 110.67
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 2,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "它胸口明明被捅穿了——为什么还能站起来？！ 危机",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_002_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 106.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 3,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "一炷香前。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_003_旁白",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 30.09
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 4,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "我不是刚下班吗……这里是哪儿？我得先活下去。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_004_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 130.41
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 5,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "枯草、尸骸，还有她身上灰扑扑的囚服。这里不是现代，而是妖魔横行的大唐。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_005_旁白",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 216.96
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 6,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "那些黑衣人袖口的赤云纹……镇魔司。传闻他们登门，便是阎王爷亲至。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_006_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 171.36
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 7,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "至于那头虎妖——胸口都空了，应该死透了吧？ 反差",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_007_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 129.48
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 8,
                "media_status": "planned_missing_reference",
                "role": "裴长青",
                "text": "过来。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_008_裴长青",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 24.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 9,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "尸堆里竟然还有活人？他浑身是伤，左臂都扭曲了。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_009_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 114.42
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 10,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "他快死了。现在逃，也许还来得及。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_010_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 84.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 11,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "她刚转身，断刀破风，钉入脚前。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_011_旁白",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 80.58
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 12,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "半截断刀，钉在了我脚前！",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_012_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 58.59
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 13,
                "media_status": "planned_missing_reference",
                "role": "裴长青",
                "text": "扶我起来。我想活着离开。我是镇魔司裴长青。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_013_裴长青",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 112.86
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 14,
                "media_status": "planned_missing_reference",
                "role": "裴长青",
                "text": "你没路引，逃不掉。帮我，我还你自由。 欲望",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_014_裴长青",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 116.82
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 15,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "画饼是画饼。可他说得没错——我连这片荒野都走不出去。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_015_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 132.93
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
