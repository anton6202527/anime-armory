  "nodes": [
    {
      "clip": "Clip_01",
      "duration_sec": 8.435,
      "id": "clip:Clip_01",
      "scene": "夕照尸场，贯胸虎妖在画右上高位睁眼起身，姜月初中景僵住，裴长青低位失血。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_02",
      "duration_sec": 6.15,
      "id": "clip:Clip_02",
      "scene": "黑场时间字卡后，姜月初从尸骸间睁眼，撑地坐起。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_03",
      "duration_sec": 7.632,
      "id": "clip:Clip_03",
      "scene": "姜月初以动作检查囚服、尸骸和荒野地貌，旁白压缩世界信息。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_04",
      "duration_sec": 11.028,
      "id": "clip:Clip_04",
      "scene": "赤云纹插入后，姜月初走到安全距离查看贯胸虎尸，只给半拍松气。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_05",
      "duration_sec": 8.614,
      "id": "clip:Clip_05",
      "scene": "裴长青从尸堆低位开口，姜月初发现他的伤势并转身准备独自离开。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_06",
      "duration_sec": 5.439,
      "id": "clip:Clip_06",
      "scene": "断刀从画右后飞来钉进姜月初脚前硬土，她脚尖僵住。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_07",
      "duration_sec": 13.487,
      "id": "clip:Clip_07",
      "scene": "姜月初与倒地裴长青沿既定轴线谈判，断刀作为中间筹码，最后她伸手。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_08",
      "duration_sec": 2.4,
      "id": "clip:Clip_08",
      "scene": "姜月初扶裴长青半站，两人朝画左南向出口挪动。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_09",
      "duration_sec": 5.874,
      "id": "clip:Clip_09",
      "scene": "两人停步回看，虎妖从同一巨石旁站起，画面追上冷开。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_10",
      "duration_sec": 9.188,
      "id": "clip:Clip_10",
      "scene": "虎妖高位宣告吞食意图；裴低声点破半步鸣骨和天赋神通，俯身从同僚尸旁捡起完整横刀并压低重心。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_11",
      "duration_sec": 9.586,
      "id": "clip:Clip_11",
      "scene": "裴沿既定轴线冲锋斩落，虎妖单脚迎击，裴被反向踢回姜月初脚边。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_12",
      "duration_sec": 6.113,
      "id": "clip:Clip_12",
      "scene": "姜月初低头看裴，再抬眼看虎妖；虎妖高位慢步逼近一小步。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_13",
      "duration_sec": 13.473,
      "id": "clip:Clip_13",
      "scene": "外界声场抽空，黑金无字古卷底框在姜月初右上视野展开，金墨光丝照亮她的眼。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_14",
      "duration_sec": 3.794,
      "id": "clip:Clip_14",
      "scene": "姜月初主观近景看虎妖虚焦巨影，手指空握又松开。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_15",
      "duration_sec": 6.582,
      "id": "clip:Clip_15",
      "scene": "姜月初视线从虎妖移到裴长青，再落到裴右侧的完整横刀；不移动，只改变选择目标。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_16",
      "duration_sec": 3.074,
      "id": "clip:Clip_16",
      "scene": "姜月初握刀起身，裴先看刀再看她；她不回避视线，只说抱歉。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_17",
      "duration_sec": 4.369,
      "id": "clip:Clip_17",
      "scene": "完整横刀沿既定方向刺入裴胸口，克制避开猎奇；少量暗红血点溅上姜月初脸颊。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_18",
      "duration_sec": 0.893,
      "id": "clip:Clip_18",
      "scene": "裴长青错愕看姜月初，只吐出一个你字；声音断后切向姜月初的后果反应。",
      "type": "story_clip"
    },
    {
      "clip": "Clip_19",
      "duration_sec": 1.3,
      "id": "clip:Clip_19",
      "scene": "姜月初脸颊新血点清晰，她握刀的手轻颤却不松开；无系统到账、无音乐，1.3秒后硬切黑。",
      "type": "story_clip"
    },
