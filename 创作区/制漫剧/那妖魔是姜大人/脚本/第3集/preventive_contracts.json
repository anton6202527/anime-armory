  "shots": [
    {
      "clip_id": "Clip_01",
      "dramatic_function": "先展示假身份被跪求的结果，再回到换装之前，让身份反噬成为本集命题。",
      "editing_intent": "0-3秒内完成『群跪+叩首+她僵住』三信息；VO2内心声压在她的CU上，随后硬切回埋尸时间线，不提前解释制服来历。",
      "emotional_turn": "",
      "source_trace_ids": [],
      "visual_question": ""
    },
    {
      "clip_id": "Clip_02",
      "dramatic_function": "她亲手埋葬给过她自由承诺的人，并拿走死者之物——杀裴的道德代价落地为可见动作。",
      "editing_intent": "浅坟合土、插枝为记、抱起叠好的黑色制服包袱三个动作一气呵成；『得罪了兄弟』压在她低头半拍上，必留她面对浅坟的沉默半拍。",
      "emotional_turn": "",
      "source_trace_ids": [],
      "visual_question": ""
    },
    {
      "clip_id": "Clip_03",
      "dramatic_function": "囚犯到假镇魔司的身份转换用衣料、束发、佩刀三动作完成；她清醒知道这步棋的双刃。",
      "editing_intent": "只拍换装的三个完成点：赤纹披上肩、束发收紧、横刀入腰扣；VO以内心声铺在动作上，唇不动；结尾一个站定的全身剪影确认新身份。",
      "emotional_turn": "",
      "source_trace_ids": [],
      "visual_question": ""
    },
    {
      "clip_id": "Clip_04",
      "dramatic_function": "贱籍无路引的死局把她的选择压到墙角，马蹄声在绝路尽头骤然响起。",
      "editing_intent": "行路LS铺内心快盘算，节奏词随步频；『走一步算一步』落在苦笑半拍；马蹄声起，她驻足、瞳孔收紧、手按刀柄，镜头回身望向道路尽头。",
      "emotional_turn": "",
      "source_trace_ids": [],
      "visual_question": ""
    },
    {
      "clip_id": "Clip_05",
      "dramatic_function": "十几骑的武力压迫在一件制服前放缓成试探；她用两个字撑住第一回合。",
      "editing_intent": "马队沿纵深轴冲近急停、尘土漫过她衣摆；陈青源勒马拱手试探，注意到玄色赤纹后语气转敬；她背对镜头半拍后只回『何事』，强装冷硬。",
      "emotional_turn": "",
      "source_trace_ids": [],
      "visual_question": ""
    },
    {
      "clip_id": "Clip_06",
      "dramatic_function": "陈青源报名陈情坐实误认；她的沉默被读作官威，假身份第一次真正兑现。",
      "editing_intent": "陈青源下马抱拳陈情，信息量大但一镜承载；穿插她眼神游移的MCU与攥紧的拇指压『装，接着装』内心快声；她始终不接话——沉默即官威。",
      "emotional_turn": "",
      "source_trace_ids": [],
      "visual_question": ""
    },
    {
