                "value": 0.0
              }
            }
          }
        ],
        "effects": [],
        "enabled": true,
        "kind": "Video",
        "markers": [
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 150.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "活下去，得先杀一个人。可我刀下的——不 是妖。"
              }
            },
            "name": "活下去，得先杀一个人。可我刀下的——不 是妖。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 214.8
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 168.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "一炷香前。大唐荒野，囚犯和镇魔卫死了一 地。我偏偏在死人堆里醒了。"
              }
            },
            "name": "一炷香前。大唐荒野，囚犯和镇魔卫死了一 地。我偏偏在死人堆里醒了。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 181.2
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 394.8
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "穿越，罪臣之女，没入贱籍。刚来就死，我 也算头一个。"
              }
            },
            "name": "穿越，罪臣之女，没入贱籍。刚来就死，我 也算头一个。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 9.6
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 594.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "过来。"
              }
            },
            "name": "过来。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 98.4
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 615.6
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "你都快断气了，还想使唤我？"
              }
            },
            "name": "你都快断气了，还想使唤我？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 85.2
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 726.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "你可以试试。下一刀，落的就不是地上。"
              }
            },
            "name": "你可以试试。下一刀，落的就不是地上。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 109.2
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 823.2
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "裴长青，陇右镇魔都司队正。扶我往南，我 保你脱籍，还你自由。"
              }
            },
            "name": "裴长青，陇右镇魔都司队正。扶我往南，我 保你脱籍，还你自由。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 123.6
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 944.4
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "一个将死之人的承诺……总好过我现在就死。"
              }
            },
            "name": "一个将死之人的承诺……总好过我现在就死。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 128.4
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1086.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "好。先说清楚，那头虎妖真死了？"
              }
            },
            "name": "好。先说清楚，那头虎妖真死了？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 61.2
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1226.4
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "别跑啊。这荒郊野岭的，你们能去哪儿？"
              }
            },
            "name": "别跑啊。这荒郊野岭的，你们能去哪儿？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 54.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1305.6
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "不可能……我明明刺穿了你的心！"
              }
            },
            "name": "不可能……我明明刺穿了你的心！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 51.6
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1371.6
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "几个不入流的镇魔卫，也配杀我？"
              }
            },
            "name": "几个不入流的镇魔卫，也配杀我？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 15.6
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1435.2
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "快走！"
              }
            },
            "name": "快走！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 39.6
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1462.8
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "裴长青！"
              }
            },
            "name": "裴长青！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 58.8
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1514.4
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "莫再挣扎。等吃干净了，我替你们立碑。"
