                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1964.46
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "杀生得道行……可这里还有谁活着？除了那 头杀不死的虎妖——"
              }
            },
            "name": "杀生得道行……可这里还有谁活着？除了那 头杀不死的虎妖——"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
