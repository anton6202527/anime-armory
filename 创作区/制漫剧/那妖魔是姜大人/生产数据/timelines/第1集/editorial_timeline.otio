              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2107.38
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "拿刀……快逃。"
              }
            },
            "name": "拿刀……快逃。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 24.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2155.98
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我想活。"
              }
            },
            "name": "我想活。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
