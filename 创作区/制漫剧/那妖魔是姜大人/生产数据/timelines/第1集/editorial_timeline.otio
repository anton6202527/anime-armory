                "story_clip": "Clip_08"
              }
            },
            "name": "Clip_08",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 386.4
