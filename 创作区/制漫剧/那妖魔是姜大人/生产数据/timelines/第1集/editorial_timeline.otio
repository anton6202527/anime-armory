              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2191.98
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "裴长青，对不住了。"
              }
            },
            "name": "裴长青，对不住了。"
