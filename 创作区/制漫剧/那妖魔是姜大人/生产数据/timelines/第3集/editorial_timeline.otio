        ],
        "effects": [],
        "enabled": true,
        "kind": "Video",
        "markers": [
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 101.07
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "恳请镇魔司大人出手，救上盘村百十口性命！"
              }
            },
            "name": "恳请镇魔司大人出手，救上盘村百十口性命！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 184.53
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 119.07
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我只是想借这身皮活命。怎么一转眼，就成 了他们唯一的救命稻草？"
              }
            },
            "name": "我只是想借这身皮活命。怎么一转眼，就成 了他们唯一的救命稻草？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 94.08
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 315.6
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "裴长青，荒郊野岭，只能委屈你了。"
              }
            },
            "name": "裴长青，荒郊野岭，只能委屈你了。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 105.15
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 421.68
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "人死了，东西还得活人用。……得罪了，兄 弟。"
              }
            },
            "name": "人死了，东西还得活人用。……得罪了，兄 弟。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 199.62
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 538.83
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "囚服是活靶子。黑衣赤纹虽险，至少——能 唬人。真唬住了，也可能把我架到狼窝门口。"
              }
            },
            "name": "囚服是活靶子。黑衣赤纹虽险，至少——能 唬人。真唬住了，也可能把我架到狼窝门口。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 123.03
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 756.45
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "刀在腰上，我才算有一点像个能活下去的人。"
              }
            },
            "name": "刀在腰上，我才算有一点像个能活下去的人。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 226.53
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 891.48
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "姜家获罪，我是贱籍；没有路引，进不了城， 也住不了店。躲进村子？迟早被查。伪造？ 我连门路都没有。"
              }
            },
            "name": "姜家获罪，我是贱籍；没有路引，进不了城， 也住不了店。躲进村子？迟早被查。伪造？ 我连门路都没有。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 155.58
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1130.01
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "刚从虎口里爬出来，前面又是死路。行吧， 走一步算一步。"
              }
            },
            "name": "刚从虎口里爬出来，前面又是死路。行吧， 走一步算一步。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 37.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1303.59
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "马蹄声？十几骑！"
              }
            },
            "name": "马蹄声？十几骑！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 78.84
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1352.97
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "敢问……可是镇魔司的大人当面？"
              }
            },
            "name": "敢问……可是镇魔司的大人当面？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 24.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1443.81
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "……何事？"
              }
            },
            "name": "……何事？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 327.18
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1485.81
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "在下飞鹰门陈青源，奉县令手令驰援上盘村。 进村后我们才发现，狼妖已占村三日；我们 折了七八个好手，实在杀不进去。可我不能 扔下他们等死。"
              }
            },
            "name": "在下飞鹰门陈青源，奉县令手令驰援上盘村。 进村后我们才发现，狼妖已占村三日；我们 折了七八个好手，实在杀不进去。可我不能 扔下他们等死。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 109.35
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1830.99
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "不能解释。解释一句，就多一个破绽。装， 接着装。"
              }
            },
            "name": "不能解释。解释一句，就多一个破绽。装， 接着装。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 186.18
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1952.34
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "活人都被圈在祠堂里，每日拖出去几个。去 兰州求援，来回至少十天——他们等不到了！"
              }
            },
            "name": "活人都被圈在祠堂里，每日拖出去几个。去 兰州求援，来回至少十天——他们等不到了！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 103.83
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2156.52
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "此地只有大人能救他们。陈某，恳请大人出 手！"
              }
            },
            "name": "此地只有大人能救他们。陈某，恳请大人出 手！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 34.62
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2272.35
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "恳请大人出手！"
              }
            },
            "name": "恳请大人出手！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 153.15
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2318.97
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "好好好……老天爷，你非要这么玩是吧？那 我还活鸡毛了。"
              }
            },
            "name": "好好好……老天爷，你非要这么玩是吧？那 我还活鸡毛了。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 171.87
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2493.12
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "狼妖、假身份、百十条人命。这趟要是去了， 我还能活着回来吗？"
              }
            },
            "name": "狼妖、假身份、百十条人命。这趟要是去了， 我还能活着回来吗？"
          }
        ],
        "metadata": {
          "n2d": {
            "track_role": "V1 Picture"
          }
        },
        "name": "V1 Picture",
        "source_range": null
      },
