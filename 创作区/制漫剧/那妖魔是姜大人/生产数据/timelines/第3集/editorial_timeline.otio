                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 1,
                "media_status": "planned_missing_reference",
                "role": "飞鹰门众人",
                "text": "恳请镇魔司大人出手，救上盘村百十口性命！",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_001_飞鹰门众人",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 101.07
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 2,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "我只是想借这身皮活命。怎么一转眼，就成了他们唯一的救命稻草？",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_002_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 184.53
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 3,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "裴长青，荒郊野岭，只能委屈你了。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_003_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 94.08
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 4,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "人死了，东西还得活人用。……得罪了，兄弟。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_004_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 105.15
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 5,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "囚服是活靶子。黑衣赤纹虽险，至少——能唬人。真唬住了，也可能把我架到狼窝门口。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_005_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 199.62
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 6,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "刀在腰上，我才算有一点像个能活下去的人。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_006_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 123.03
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 7,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "姜家获罪，我是贱籍；没有路引，进不了城，也住不了店。躲进村子？迟早被查。伪造？我连门路都没有。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_007_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 226.53
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 8,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "刚从虎口里爬出来，前面又是死路。行吧，走一步算一步。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_008_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 155.58
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 9,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "马蹄声？十几骑！",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_009_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 37.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 10,
                "media_status": "planned_missing_reference",
                "role": "陈青源",
                "text": "敢问……可是镇魔司的大人当面？",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_010_陈青源",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 78.84
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 11,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "……何事？",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_011_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 24.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 12,
                "media_status": "planned_missing_reference",
                "role": "陈青源",
                "text": "在下飞鹰门陈青源，奉县令手令驰援上盘村。进村后我们才发现，狼妖已占村三日；我们折了七八个好手，实在杀不进去。可我不能扔下他们等死。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_012_陈青源",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 327.18
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 13,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "不能解释。解释一句，就多一个破绽。装，接着装。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_013_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 109.35
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.6,
                "line_index": 14,
                "media_status": "planned_missing_reference",
                "role": "陈青源",
                "text": "活人都被圈在祠堂里，每日拖出去几个。去兰州求援，来回至少十天——他们等不到了！",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_014_陈青源",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 186.18
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 15,
                "media_status": "planned_missing_reference",
                "role": "陈青源",
                "text": "此地只有大人能救他们。陈某，恳请大人出手！",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_015_陈青源",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 103.83
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 16,
                "media_status": "planned_missing_reference",
                "role": "飞鹰门众人",
                "text": "恳请大人出手！",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_016_飞鹰门众人",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 34.62
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.7,
                "line_index": 17,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "好好好……老天爷，你非要这么玩是吧？那我还活鸡毛了。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_017_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 153.15
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
