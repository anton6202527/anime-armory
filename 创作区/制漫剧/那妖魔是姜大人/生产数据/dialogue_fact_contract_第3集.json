          "source": "脚本/第3集/voiceover.txt:22",
          "text": "言多必失。镇魔司的大人，就该少说话。"
        },
        {
          "index": 21,
          "role": "姜月初",
          "source": "脚本/第3集/voiceover.txt:23",
          "text": "何事？"
        }
      ],
      "allowed_character_dialogue_indices": [
