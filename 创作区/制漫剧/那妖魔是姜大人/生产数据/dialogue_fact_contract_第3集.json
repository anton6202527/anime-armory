    {
      "allowed_character_dialogue": [
        {
          "index": 6,
          "role": "姜月初",
          "source": "脚本/第3集/voiceover.txt:8",
          "text": "得罪了，兄弟。  ⚡钩子"
        }
      ],
      "allowed_character_dialogue_indices": [
        6
      ],
      "allowed_dialogue": [
        {
          "index": 5,
          "role": "旁白",
          "source": "脚本/第3集/voiceover.txt:7",
          "text": "她停在一具年轻镇魔卫身前。那人身形与她相仿，黑衣赤纹，血污未干。"
        },
        {
          "index": 6,
          "role": "姜月初",
          "source": "脚本/第3集/voiceover.txt:8",
          "text": "得罪了，兄弟。  ⚡钩子"
        },
        {
          "index": 7,
          "role": "旁白",
          "source": "脚本/第3集/voiceover.txt:9",
          "text": "囚服是活靶子。镇魔司的皮也危险。可两害相权，她宁愿披上更不好惹的那一张。"
        },
        {
          "index": 8,
          "role": "旁白",
          "source": "脚本/第3集/voiceover.txt:10",
          "text": "长发束起，横刀挂腰。虎山神换来的圆满刀法还在掌心发烫，月光照在黑衣赤纹上，像一层借来的官威。  💥爽点"
        }
      ],
      "allowed_narration": [
