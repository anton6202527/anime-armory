    {
      "allowed_character_dialogue": [
        {
          "index": 9,
          "role": "姜月初",
          "source": "脚本/第3集/voiceover.txt:11",
          "text": "不伦不类。可好歹，看着不像刚从死牢里爬出来。"
        },
        {
          "index": 12,
          "role": "姜月初",
          "source": "脚本/第3集/voiceover.txt:14",
          "text": "无户籍，是黑户；无路引，是流民。姜家贱籍一挂，我进城也是自投罗网。"
        }
      ],
      "allowed_character_dialogue_indices": [
        9,
        12
      ],
      "allowed_dialogue": [
        {
          "index": 9,
          "role": "姜月初",
          "source": "脚本/第3集/voiceover.txt:11",
          "text": "不伦不类。可好歹，看着不像刚从死牢里爬出来。"
        },
        {
          "index": 10,
          "role": "旁白",
          "source": "脚本/第3集/voiceover.txt:12",
          "text": "当她握住刀柄时，方才生死一刀换来的记忆，终于让心口安定了半分。  💥爽点"
        },
        {
          "index": 11,
          "role": "旁白",
          "source": "脚本/第3集/voiceover.txt:13",
          "text": "官道空旷，孤月悬天。她一边走，一边盘算自己的死局。"
        },
        {
          "index": 12,
          "role": "姜月初",
          "source": "脚本/第3集/voiceover.txt:14",
          "text": "无户籍，是黑户；无路引，是流民。姜家贱籍一挂，我进城也是自投罗网。"
        },
        {
          "index": 13,
          "role": "旁白",
          "source": "脚本/第3集/voiceover.txt:15",
          "text": "荒野杀野兽、杀妖物，也能换道行。可她这辈子不想当野人。要活得像个人，先得有个身份。"
        }
      ],
