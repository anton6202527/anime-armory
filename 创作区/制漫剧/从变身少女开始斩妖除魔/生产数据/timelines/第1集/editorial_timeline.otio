                "rate": 30.0,
                "value": 2103.39
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "击杀闻弦境生物。获得道行，二十年。 钩 子"
              }
            },
            "name": "击杀闻弦境生物。获得道行，二十年。 钩 子"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
