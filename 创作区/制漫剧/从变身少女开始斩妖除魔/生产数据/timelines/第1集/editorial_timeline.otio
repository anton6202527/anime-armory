                "rate": 30.0,
                "value": 2214.6
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "杀了同类，就想活？你们人族，真脏。"
              }
            },
            "name": "杀了同类，就想活？你们人族，真脏。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
