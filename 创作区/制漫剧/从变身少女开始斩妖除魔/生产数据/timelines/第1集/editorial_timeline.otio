                "rate": 30.0,
                "value": 2324.04
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "脏不脏， 等我先斩了你再说。"
              }
            },
            "name": "脏不脏， 等我先斩了你再说。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
