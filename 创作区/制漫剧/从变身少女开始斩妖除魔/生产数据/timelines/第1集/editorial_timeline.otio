        ],
        "effects": [],
        "enabled": true,
        "kind": "Video",
        "markers": [
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 136.2
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "活下去，得先杀一个人。可我刀下的——不 是妖。 钩子"
              }
            },
            "name": "活下去，得先杀一个人。可我刀下的——不 是妖。 钩子"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 98.85
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 154.2
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "十分钟前。大唐荒野，囚车尽毁，满地死尸。"
              }
            },
            "name": "十分钟前。大唐荒野，囚车尽毁，满地死尸。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 122.7
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 265.05
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "穿越。罪臣之女。贱籍。这开局，是一点活 路都没给我。"
              }
            },
            "name": "穿越。罪臣之女。贱籍。这开局，是一点活 路都没给我。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 64.86
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 399.75
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "过来。别逼我再扔一刀。"
              }
            },
            "name": "过来。别逼我再扔一刀。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 58.59
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 476.61
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "都快断气了，手还这么稳？"
              }
            },
            "name": "都快断气了，手还这么稳？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 165.42
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 547.2
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "裴长青，陇右镇魔都司队正。我得往南。扶 我走，我替你脱籍。"
              }
            },
            "name": "裴长青，陇右镇魔都司队正。我得往南。扶 我走，我替你脱籍。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 61.77
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 724.62
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "自由身？你拿什么保？"
              }
            },
            "name": "自由身？你拿什么保？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 155.58
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 798.39
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "拿镇魔司三个字。你敢离开，没路引，就会 死在这片荒野。"
              }
            },
            "name": "拿镇魔司三个字。你敢离开，没路引，就会 死在这片荒野。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 51.51
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 965.97
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "……行。先活着，再算账。"
              }
            },
            "name": "……行。先活着，再算账。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 123.3
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1029.48
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "别逃啊。这荒郊野岭的，你们能去哪儿？ 钩子"
              }
            },
            "name": "别逃啊。这荒郊野岭的，你们能去哪儿？ 钩子"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 64.68
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1170.78
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "不可能……你的心，明明碎了！"
              }
            },
            "name": "不可能……你的心，明明碎了！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 90.72
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1247.46
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "几个不入流的镇魔卫，也配杀我？"
              }
            },
            "name": "几个不入流的镇魔卫，也配杀我？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 24.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1350.18
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "快逃！"
              }
            },
            "name": "快逃！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 24.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1386.18
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "裴长青！"
              }
            },
            "name": "裴长青！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 129.75
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1422.18
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我要吃得干净些。莫再挣扎， 我替你们立 块碑。"
              }
            },
            "name": "我要吃得干净些。莫再挣扎， 我替你们立 块碑。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 107.01
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1563.93
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "百妖谱开启。斩杀生物，可得道行。 钩子"
              }
            },
            "name": "百妖谱开启。斩杀生物，可得道行。 钩子"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 155.58
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1688.94
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "道行可尽付一击；亦可用妖血为墨，收录其 形，夺其馈赠。"
              }
            },
            "name": "道行可尽付一击；亦可用妖血为墨，收录其 形，夺其馈赠。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 88.44
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1856.52
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "斩杀生物……可这里还活着的，除了虎妖— —"
              }
            },
            "name": "斩杀生物……可这里还活着的，除了虎妖— —"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
