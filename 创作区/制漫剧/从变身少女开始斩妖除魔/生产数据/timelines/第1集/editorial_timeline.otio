              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "你……"
              }
            },
            "name": "你……"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
