            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 32,
                "media_status": "planned_missing_reference",
                "role": "系统",
                "text": "获得妖物馈赠：猛虎快刀，圆满。境界：闻弦初境。剩余道行：二十五年。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_032_系统",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 157.32
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
