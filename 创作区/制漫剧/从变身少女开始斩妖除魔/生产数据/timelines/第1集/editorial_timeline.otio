                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "二十年道行——， 全给这一斩！ 爽点",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_025_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 69.21
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 26,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "人与妖交错。横刀斩过，刀脱手，虎首落地。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_026_旁白",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 98.85
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 27,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "咳……道行反噬，差点把我也劈了。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_027_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 91.65
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 28,
                "media_status": "planned_missing_reference",
                "role": "系统",
                "text": "击杀闻弦境妖物。获得道行，一百年。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_028_系统",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 82.59
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 29,
                "media_status": "planned_missing_reference",
                "role": "系统",
                "text": "检测到未收录妖物。是否消耗七十五年道行，摹影虎山神？",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_029_系统",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 158.7
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 30,
                "media_status": "planned_missing_reference",
                "role": "姜月初",
                "text": "收录。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_030_姜月初",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
