  "dialogue_registers": {
    "CHAR_01": {
      "formality": "外在用简洁克制的现代白话，面对官署保留必要敬称；现代男性意识只在短促内心句中显露，不说平台热梗。",
      "anchors": [
        "先活下来。",
        "这笔账，我记着。",
        "刀给我。"
      ],
      "forbidden_terms": [
        "家人们",
        "绝绝子",
        "老铁",
        "YYDS"
      ],
      "sentence_len_max": 28
    },
    "CHAR_02": {
      "formality": "重伤镇魔司队正，短句、职业化、气息断续；不长篇讲设定。",
      "anchors": [
        "妖在后面。",
        "拿刀。"
      ],
      "forbidden_terms": [
        "小姐姐",
        "兄弟们",
        "稳了"
      ],
      "sentence_len_max": 22
    },
    "CHAR_03": {
      "formality": "边村武人和门主语域，谨慎、有担当，称谓朴素，不端仙门腔。",
      "anchors": [
        "先护住村里人。",
        "此事不能赌。"
      ],
      "forbidden_terms": [
        "道友",
        "本座",
        "逆天"
      ],
      "sentence_len_max": 32
    },
    "CHAR_04": {
      "formality": "兽性威压优先，语言极少；若有可理解表达也保持领地与猎食逻辑。",
      "anchors": [
        "吼——"
      ],
      "forbidden_terms": [
        "人类，你成功引起了我的注意",
        "萌"
      ],
      "sentence_len_max": 18
    },
    "CHAR_05": {
      "formality": "表面文雅礼貌、内里捕食威胁；古意来自措辞与停顿，不堆砌文言。",
      "anchors": [
        "姑娘何必多管闲事。",
        "在下只取该取之物。"
      ],
      "forbidden_terms": [
        "小姐姐",
        "小可爱",
        "本王"
      ],
      "sentence_len_max": 30
    },
    "CHAR_06": {
      "formality": "中年主将式克制权威，先问证据与后果再表态；不靠吼叫或帝王腔。",
      "anchors": [
        "把话说清楚。",
        "镇魔司不收来历不明的人。"
      ],
      "forbidden_terms": [
        "大胆",
        "本王",
        "蝼蚁"
      ],
      "sentence_len_max": 34
    },
    "CHAR_07": {
      "formality": "年轻镇魔卫，直、短、行动导向；服从命令但保留个人判断。",
      "anchors": [
        "我去前面。",
        "先救人。"
      ],
      "forbidden_terms": [
        "整活",
        "稳住我们能赢",
        "老六"
      ],
      "sentence_len_max": 26
    },
    "CHAR_08": {
      "formality": "风霜校尉，沉稳务实，以战况、伤亡和命令为中心。",
      "anchors": [
        "报伤亡。",
        "阵线不能再退。"
      ],
      "forbidden_terms": [
        "兄弟萌",
        "冲就完了",
        "稳赢"
      ],
      "sentence_len_max": 30
    },
    "CHAR_09": {
      "formality": "温和医者，观察具体伤情后说话；不仙气飘渺、不无依据圣母化。",
      "anchors": [
        "先别动，我看伤口。",
        "这不是寻常外伤。"
      ],
      "forbidden_terms": [
        "公子",
        "仙缘",
        "天命之人"
      ],
      "sentence_len_max": 30
    },
    "CHAR_10": {
      "formality": "高体量凶妖，以咆哮、短促意志和行动表达为主，不承担百科说明。",
      "anchors": [
        "杀——"
      ],
      "forbidden_terms": [
        "桀桀桀",
        "蝼蚁",
        "有趣的女人"
      ],
      "sentence_len_max": 16
    }
