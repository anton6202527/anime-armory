        "effects": [],
        "enabled": true,
        "kind": "Video",
        "markers": [
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 128.79
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "武松睁眼时，虎爪已经压到脸前——今晚， 是一场生死搏杀。"
              }
            },
            "name": "武松睁眼时，虎爪已经压到脸前——今晚， 是一场生死搏杀。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 120.18
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 146.79
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "它冲，我闪；它掀，我躲；虎尾横扫，我再 让。只有三招！"
              }
            },
            "name": "它冲，我闪；它掀，我躲；虎尾横扫，我再 让。只有三招！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 79.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 278.97
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "猛虎第三次冲来，他双手抡起梢棒——"
              }
            },
            "name": "猛虎第三次冲来，他双手抡起梢棒——"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 24.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 370.35
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "棒断了！"
              }
            },
            "name": "棒断了！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 29.31
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 412.35
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我来用拳头。"
              }
            },
            "name": "我来用拳头。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 180.84
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 453.66
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "因为他打死猛虎、又把赏银让给猎户，武松 赢得满城敬重，也获得了都头腰牌。"
              }
            },
            "name": "因为他打死猛虎、又把赏银让给猎户，武松 赢得满城敬重，也获得了都头腰牌。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 176.76
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 655.5
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "山里的虎拦不住他。家门里的人心，却不是 一双拳头能打明白。"
              }
            },
            "name": "山里的虎拦不住他。家门里的人心，却不是 一双拳头能打明白。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 128.13
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 844.26
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "哥哥武大，为了换一家人的安稳，只守着一 担炊饼。"
              }
            },
            "name": "哥哥武大，为了换一家人的安稳，只守着一 担炊饼。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 152.22
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 984.39
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我想要自己做一回主。可从小到大，谁问过 我愿不愿意？"
              }
            },
            "name": "我想要自己做一回主。可从小到大，谁问过 我愿不愿意？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 37.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1148.61
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "二弟！真的是你！"
              }
            },
            "name": "二弟！真的是你！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 34.86
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1197.99
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "哥，我回来了。"
              }
            },
            "name": "哥，我回来了。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 142.86
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1244.85
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "武大把兄弟领上楼。潘金莲第一次见到这个 打虎的都头。"
              }
            },
            "name": "武大把兄弟领上楼。潘金莲第一次见到这个 打虎的都头。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 200.82
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1399.71
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "叔叔一个人在外住，连口热饭都没有。我想 要一家人住得近些，也好照应。"
              }
            },
            "name": "叔叔一个人在外住，连口热饭都没有。我想 要一家人住得近些，也好照应。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 57.93
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1618.53
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "嫂嫂厚意，武二记下了。"
              }
            },
            "name": "嫂嫂厚意，武二记下了。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 140.01
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1688.46
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "他住进来一个月。她递过去的每句话，都比 上一句更近。"
              }
            },
            "name": "他住进来一个月。她递过去的每句话，都比 上一句更近。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 172.8
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 1840.47
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "大雪封街这天，武大刚出门，那扇门就在她 手里关闭，门闩随即落下。"
              }
            },
            "name": "大雪封街这天，武大刚出门，那扇门就在她 手里关闭，门闩随即落下。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 110.37
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2031.27
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "叔叔，外头冷。坐近些，饮一杯暖暖身子。"
              }
            },
            "name": "叔叔，外头冷。坐近些，饮一杯暖暖身子。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 52.14
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2153.64
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "等哥哥回来，一起喝。"
              }
            },
            "name": "等哥哥回来，一起喝。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 147.45
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2217.78
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我又没逼你。只是他日日只认那副炊饼担， 哪里懂得心疼人？"
              }
            },
            "name": "我又没逼你。只是他日日只认那副炊饼担， 哪里懂得心疼人？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 107.01
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2377.23
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "嫂嫂。那是我亲哥哥。我必须对得起他。"
              }
            },
            "name": "嫂嫂。那是我亲哥哥。我必须对得起他。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 113.46
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2502.24
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我要你看着我。你若有心，就饮我这半杯。"
              }
            },
            "name": "我要你看着我。你若有心，就饮我这半杯。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 101.46
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2627.7
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "武松打翻酒盏，酒泼在地上，炭火噼啪一响。"
              }
            },
            "name": "武松打翻酒盏，酒泼在地上，炭火噼啪一响。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 168.51
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2741.16
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我敬你是嫂嫂，才坐到现在。你若再敢越一 步，武二绝不容你。"
              }
            },
            "name": "我敬你是嫂嫂，才坐到现在。你若再敢越一 步，武二绝不容你。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 122.16
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 2930.67
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "武大回家时，她先红了眼，也先把真相藏了 起来。"
              }
            },
            "name": "武大回家时，她先红了眼，也先把真相藏了 起来。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 87.9
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3064.83
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "你那好兄弟，趁家里没人，反来调戏我！"
              }
            },
            "name": "你那好兄弟，趁家里没人，反来调戏我！"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 68.91
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3170.73
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "我兄弟……不是这样的人。"
              }
            },
            "name": "我兄弟……不是这样的人。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 95.31
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3251.64
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "武松一句也没争。他把行李重新系好。"
              }
            },
            "name": "武松一句也没争。他把行李重新系好。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 46.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3364.95
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "二弟，你要去哪里？"
              }
            },
            "name": "二弟，你要去哪里？"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 120.18
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3423.33
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "哥哥，不要问。我得离开。门，我替你关不 上。"
              }
            },
            "name": "哥哥，不要问。我得离开。门，我替你关不 上。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 154.98
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3555.51
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "因此，他搬出了那扇门。想避开闲话，反倒 把哥哥留在了门里。"
              }
            },
            "name": "因此，他搬出了那扇门。想避开闲话，反倒 把哥哥留在了门里。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 127.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3728.49
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "武都头，有一担礼要送往东京。路远人杂， 非你不可。"
              }
            },
            "name": "武都头，有一担礼要送往东京。路远人杂， 非你不可。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 81.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3867.87
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "蒙相公差遣，我明日就要去东京。"
              }
            },
            "name": "蒙相公差遣，我明日就要去东京。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 185.07
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 3960.87
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "哥，我不在时，少出早归，早闭门户。我会 回来；有人欺你，等我理论。"
              }
            },
            "name": "哥，我不在时，少出早归，早闭门户。我会 回来；有人欺你，等我理论。"
          },
          {
            "OTIO_SCHEMA": "Marker.2",
            "color": "GREEN",
            "marked_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 173.58
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 4157.94
              }
            },
            "metadata": {
              "n2d": {
                "subtitle_text": "武松出城那天，潘金莲站在楼窗后。帘外， 另一双眼已经走近。"
              }
            },
            "name": "武松出城那天，潘金莲站在楼窗后。帘外， 另一双眼已经走近。"
          }
        ],
        "metadata": {
          "n2d": {
            "track_role": "V1 Picture"
          }
        },
        "name": "V1 Picture",
        "source_range": null
      },
      {
