                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 31,
                "media_status": "planned_missing_reference",
                "role": "知县",
                "text": "武都头，有一担礼要送往东京。路远人杂，非你不可。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_031_知县",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 127.38
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 32,
                "media_status": "planned_missing_reference",
                "role": "武松",
                "text": "蒙相公差遣，我明日就要去东京。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_032_武松",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 81.0
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 33,
                "media_status": "planned_missing_reference",
                "role": "武松",
                "text": "哥，我不在时，少出早归，早闭门户。我会回来；有人欺你，等我理论。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_033_武松",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
