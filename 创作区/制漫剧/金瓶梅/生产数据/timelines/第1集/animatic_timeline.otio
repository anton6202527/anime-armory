              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 5,
                "media_status": "planned_missing_reference",
                "role": "武松",
                "text": "我来用拳头。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_005_武松",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 29.31
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.7,
                "line_index": 6,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "因为他打死猛虎、又把赏银让给猎户，武松赢得满城敬重，也获得了都头腰牌。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_006_旁白",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 180.84
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 7,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "山里的虎拦不住他。家门里的人心，却不是一双拳头能打明白。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_007_旁白",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 176.76
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 8,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "哥哥武大，为了换一家人的安稳，只守着一担炊饼。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_008_旁白",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 128.13
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
            "markers": [],
            "media_references": {
              "DEFAULT_MEDIA": {
                "OTIO_SCHEMA": "MissingReference.1",
                "available_image_bounds": null,
                "available_range": null,
                "metadata": {
                  "n2d": {
                    "missing": true
                  }
                },
                "name": "missing_media"
              }
            },
            "metadata": {
              "n2d": {
                "gap_after_sec": 0.4,
                "line_index": 9,
                "media_status": "planned_missing_reference",
                "role": "潘金莲",
                "text": "我想要自己做一回主。可从小到大，谁问过我愿不愿意？",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
              }
            },
            "name": "VO_PLAN_009_潘金莲",
            "source_range": {
              "OTIO_SCHEMA": "TimeRange.1",
              "duration": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 152.22
              },
              "start_time": {
                "OTIO_SCHEMA": "RationalTime.1",
                "rate": 30.0,
                "value": 0.0
              }
            }
          },
          {
            "OTIO_SCHEMA": "Clip.2",
            "active_media_reference_key": "DEFAULT_MEDIA",
            "effects": [],
            "enabled": true,
