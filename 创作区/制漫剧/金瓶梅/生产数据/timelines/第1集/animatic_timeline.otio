                "gap_after_sec": 0,
                "line_index": 34,
                "media_status": "planned_missing_reference",
                "role": "旁白",
                "text": "武松出城那天，潘金莲站在楼窗后。帘外，另一双眼已经走近。",
                "timing_basis": "text_estimate_no_audio",
                "track_role": "A1 Dialogue_Narration",
                "voice_lock_required": true
