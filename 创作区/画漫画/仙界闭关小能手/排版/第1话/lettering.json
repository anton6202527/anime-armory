      "slot_id": "B004S",
      "style": {
        "font": "project_default",
        "size": 72,
        "direction": "horizontal",
        "bubble": "none"
      }
    },
    {
      "item_id": "L008",
      "panel_id": "P005",
      "type": "dialogue",
      "speaker": "张老大",
      "text": "从今日起，秀竹峰挑水的活儿便由你来负责。",
      "text_zh": "从今日起，秀竹峰挑水的活儿便由你来负责。",
      "tone": "",
      "slot_id": "B005D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L009",
      "panel_id": "P005",
      "type": "sfx",
      "speaker": "",
      "text": "啪",
      "text_zh": "啪",
      "slot_id": "B005S",
      "style": {
        "font": "project_default",
        "size": 72,
        "direction": "horizontal",
        "bubble": "none"
      }
    },
    {
      "item_id": "L010",
      "panel_id": "P006",
      "type": "narration",
      "speaker": "",
      "text": "秀竹峰两处用水，每日不下二十趟。",
      "text_zh": "秀竹峰两处用水，每日不下二十趟。",
      "slot_id": "B006N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L011",
      "panel_id": "P006",
      "type": "dialogue",
      "speaker": "张老大",
      "text": "每日天不亮开始挑水，到晚上方能停止。",
      "text_zh": "每日天不亮开始挑水，到晚上方能停止。",
      "tone": "",
      "slot_id": "B006D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L012",
      "panel_id": "P006",
      "type": "dialogue",
      "speaker": "贺平生",
      "text": "是。",
      "text_zh": "是。",
      "tone": "",
      "slot_id": "B006D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L013",
      "panel_id": "P007",
      "type": "narration",
      "speaker": "",
      "text": "韩老三领他熟悉秀竹峰。",
      "text_zh": "韩老三领他熟悉秀竹峰。",
      "slot_id": "B007N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L014",
      "panel_id": "P008",
      "type": "narration",
      "speaker": "",
      "text": "父母早亡，资源被夺；九岁觉醒五行灵根，却被太虚门视作费钱货。",
      "text_zh": "父母早亡，资源被夺；九岁觉醒五行灵根，却被太虚门视作费钱货。",
      "slot_id": "B008N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L015",
      "panel_id": "P009",
      "type": "narration",
      "speaker": "",
      "text": "这是他的房间。",
      "text_zh": "这是他的房间。",
      "slot_id": "B009N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
