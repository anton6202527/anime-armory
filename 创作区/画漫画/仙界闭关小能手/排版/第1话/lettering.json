    {
      "item_id": "L002",
      "panel_id": "P001",
      "type": "dialogue",
      "speaker": "贺平生",
      "text": "回张老大的话，我今年十四岁。",
      "text_zh": "回张老大的话，我今年十四岁。",
      "tone": "",
      "slot_id": "B001D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L003",
      "panel_id": "P002",
      "type": "dialogue",
      "speaker": "张老大",
      "text": "什么灵根？",
      "text_zh": "什么灵根？",
      "tone": "",
      "slot_id": "B002D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L004",
      "panel_id": "P002",
      "type": "dialogue",
      "speaker": "贺平生",
      "text": "是个五行灵根。",
      "text_zh": "是个五行灵根。",
      "tone": "",
      "slot_id": "B002D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L005",
      "panel_id": "P003",
      "type": "dialogue",
      "speaker": "张老大",
      "text": "原来是个费钱货。",
      "text_zh": "原来是个费钱货。",
      "tone": "",
      "slot_id": "B003D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L006",
      "panel_id": "P004",
      "type": "dialogue",
      "speaker": "杂役群像",
      "text": "哈哈哈哈！",
      "text_zh": "哈哈哈哈！",
      "tone": "",
      "slot_id": "B004D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L007",
      "panel_id": "P004",
      "type": "sfx",
      "speaker": "",
      "text": "簌簌",
