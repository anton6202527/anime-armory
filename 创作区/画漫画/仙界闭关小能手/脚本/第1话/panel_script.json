  "panels": [
    {
      "panel_id": "P001",
      "story_function": "opening_pressure",
      "description": "黑暗、像破庙一样的大殿内，粗壮油污的张老大俯视一个身高不足五尺的十四岁少年贺平生。",
      "characters": ["CHAR_HE_PINGSHENG", "张老大"],
      "location": "黑暗大殿",
      "dialogue": [
        {"speaker": "张老大", "text": "你叫贺平生？多大了？"},
        {"speaker": "贺平生", "text": "回张老大的话，我今年十四岁。"}
      ],
      "narration": "",
      "sfx": [],
      "art_notes": "竖向开场压迫构图；张老大占画面上方，贺平生瘦小、低头、恭敬。贺平生必须是少年版，从成年定型图幼年化。",
      "references": ["CHAR_HE_PINGSHENG"]
    },
    {
      "panel_id": "P002",
