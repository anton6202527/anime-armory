    {
      "item_id": "L023",
      "panel_id": "P016",
      "type": "narration",
      "speaker": "",
      "text": "一纸房奁，一身红衣。她从张家的门，进了武大的家。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S031：张大户倒赔房奁，把金莲嫁与武大。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "一纸房奁，一身红衣。她从张家的门，进了武大的家。",
      "slot_id": "B016N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
