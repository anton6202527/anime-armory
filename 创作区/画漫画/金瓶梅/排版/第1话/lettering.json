    {
      "item_id": "L014",
      "panel_id": "P009",
      "type": "narration",
      "speaker": "",
      "text": "伏了一夜的猎户，等来的不是虎，是打虎的人。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S007",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "伏了一夜的猎户，等来的不是虎，是打虎的人。",
