    {
      "item_id": "L022",
      "panel_id": "P015",
      "type": "narration",
      "speaker": "",
      "text": "错不在她，棍子却只落在她身上。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S031：主家婆察觉张大户私情，将金莲苦打。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "错不在她，棍子却只落在她身上。",
      "slot_id": "B015N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
