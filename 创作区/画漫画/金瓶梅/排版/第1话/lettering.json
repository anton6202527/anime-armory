    {
      "item_id": "L017",
      "panel_id": "P012",
      "type": "narration",
      "speaker": "",
      "text": "金莲不是走进武家的。她是被推过去的。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S010",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "金莲不是走进武家的。她是被推过去的。",
