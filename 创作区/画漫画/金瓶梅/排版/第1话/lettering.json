      "panel_id": "P005",
      "type": "narration",
      "speaker": "",
      "text": "日头正往山背后沉。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S011：日色下山，武松酒力发作，在卧牛石旁歇息。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "日头正往山背后沉。",
      "slot_id": "B005N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
