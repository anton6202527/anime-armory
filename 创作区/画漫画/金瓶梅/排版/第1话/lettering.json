    {
      "item_id": "L018",
      "panel_id": "P013",
      "type": "narration",
      "speaker": "",
      "text": "半年前。张大户家。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S029-S030：武大租居张大户临街房，富户家中正要买使女。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "半年前。张大户家。",
      "slot_id": "B013N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
