      "panel_id": "P017",
      "type": "dialogue",
      "speaker": "武大",
      "text": "我多赚几个钱，不教你受饿。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "我多赚几个钱，不教你受饿。",
