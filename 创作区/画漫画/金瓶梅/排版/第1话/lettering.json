      "panel_id": "P018",
      "type": "narration",
      "speaker": "",
      "text": "帘子里，是家。帘子外，是另一个世界。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S033：金莲每日在帘子下嗑瓜子，街上闲人聚来。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "帘子里，是家。帘子外，是另一个世界。",
      "slot_id": "B018N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
