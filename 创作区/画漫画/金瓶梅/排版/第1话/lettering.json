    {
      "item_id": "L016",
      "panel_id": "P011",
      "type": "narration",
      "speaker": "",
      "text": "清河县记住了武松，也轻贱着武大。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S009",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "清河县记住了武松，也轻贱着武大。",
