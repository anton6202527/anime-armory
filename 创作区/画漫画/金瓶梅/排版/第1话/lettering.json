  "items": [
    {
      "item_id": "L001",
      "panel_id": "P001",
      "type": "narration",
      "speaker": "",
      "text": "贪她的，断送六尺之躯；爱她的，丢了泼天产业。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S008：说书人先道尸横刀下的结局。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "贪她的，断送六尺之躯；爱她的，丢了泼天产业。",
      "slot_id": "B001N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L002",
      "panel_id": "P002",
      "type": "narration",
      "speaker": "",
      "text": "政和年间，世道的风，一路吹进了清河县。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S009：政和年间世道纷乱。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "政和年间，世道的风，一路吹进了清河县。",
      "slot_id": "B002N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L003",
      "panel_id": "P003",
      "type": "dialogue",
      "speaker": "武松",
      "text": "这一走，也不知哥哥如何了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "这一走，也不知哥哥如何了。",
      "tone": "低声自语",
      "slot_id": "B003D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
