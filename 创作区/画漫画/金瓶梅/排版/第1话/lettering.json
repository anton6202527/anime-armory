      "panel_id": "P009",
      "type": "narration",
      "speaker": "",
      "text": "再起来——我便没命了！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S012、S021-S023：武松按住虎头，拳脚如雨。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "再起来——我便没命了！",
      "slot_id": "B009N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
