      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L018",
      "panel_id": "P013",
      "type": "narration",
      "speaker": "",
      "text": "帘子一掀，整条街都看过来。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S011",
      "source_lang": "und",
