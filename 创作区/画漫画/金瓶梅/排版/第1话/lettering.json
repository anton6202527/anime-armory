      "panel_id": "P004",
      "type": "dialogue",
      "speaker": "武松",
      "text": "怕甚么鸟。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "怕甚么鸟。",
