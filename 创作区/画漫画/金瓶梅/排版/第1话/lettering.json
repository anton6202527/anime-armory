    {
      "item_id": "L020",
      "panel_id": "P014",
      "type": "narration",
      "speaker": "",
      "text": "她叫潘金莲。九岁入府，一手好琵琶。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S030：张大户买得潘金莲，教弹唱。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "她叫潘金莲。九岁入府，一手好琵琶。",
