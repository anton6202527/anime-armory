    {
      "item_id": "L015",
      "panel_id": "P010",
      "type": "narration",
      "speaker": "",
      "text": "赏银散给众人。官帽，落到武松头上。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S008",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "赏银散给众人。官帽，落到武松头上。",
      "slot_id": "B010N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
