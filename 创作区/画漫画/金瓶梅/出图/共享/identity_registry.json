    "CHAR_PAN": {
      "id": "CHAR_PAN",
      "type": "character",
      "status": "ready",
      "display_name": "潘金莲",
      "scope": "long_running_core",
      "character_dna": "二十岁上下，精致鹅蛋脸，细弯眉，眼神机敏、怨愤与试探并存；黑发盘髻，宋式窄袖衫裙，绛红/暗金发簪点缀。",
      "dna_contract": "所有形态继承同一脸型、细眉、眼型、发际线、发髻轮廓和机敏眼神。使女回忆态、武家新妇态、帘下试探态只改服装层、表情和光影，不色情化。",
      "variant_policy": "使女回忆态低头避权势；武家新妇态衣饰整洁但不奢华；帘下试探态以眼神和门帘构图表现，不露骨。",
      "forbidden_inheritance": "不得画成现代性感写真、暴露衣装、纯网红脸、Q版萌化或色情挑逗姿势。",
      "notes": "第1话是使女出身/武家新妇阶段，不是西门府华服阶段。服装保守克制，允许绛红/青绿/暗金小面积点染；眼神表现压抑、机敏、怨意和试探。不像任何影视演员，不借成人片造型。",
      "age_variants": {
        "使女回忆态": "更朴素，低头，深宅压迫光。",
        "武家新妇态": "宋式窄袖衫裙，绛红发簪，门帘半影。",
        "帘下试探态": "礼节动作与试探眼神并存，不越界肢体接触。"
      },
