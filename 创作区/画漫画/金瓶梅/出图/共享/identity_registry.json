{
  "schema_version": 1,
  "kind": "comic_identity_registry",
  "title": "金瓶梅",
  "style_contract": "古典世情水墨写实条漫；黑白灰水墨线稿和灰阶体积为主，绛红只作门帘、血点、官符和衣饰点染；北宋市井烟火真实可感；人物脸部精细但不网红化；不画露骨情色。",
  "consistency_policy": "长线高一致性：常驻人物需 front / three_quarter / side / back / face 五视图；场景和道具需独立锚点；每格真实传入参考图，不靠口头路径。无持久主体 ID 的 OpenAI/Codex 路线必须用 reference group + 逐格 reference manifest + gate 人审闭环补足。",
  "forbidden_inheritance": [
    "不得继承任何现代摄影、现代服饰、平台 UI、水印、可读随机文字或现代物件。",
    "不得把世情情色改成露骨裸露、性行为或色情化身体特写。",
    "不得把北宋市井改成仙侠宫殿、现代街区或高饱和游戏风。",
    "影视资料只用于服制、阶层、场景和叙事功能参考，不复刻演员脸、剧照构图、镜头调度或成人片尺度。"
  ],
  "assets": {
    "CHAR_WUSONG": {
      "id": "CHAR_WUSONG",
      "type": "character",
      "status": "ready",
      "display_name": "武松",
      "scope": "long_running_core",
      "character_dna": "高大健壮，宽肩厚背，方正硬朗脸型，眉骨硬，眼神正直锐利，黑发束起，短须或青茬克制；气质刚烈、守礼、行动果断。",
      "dna_contract": "所有形态继承同一脸型、眉眼、发际线、发量、肩背比例和刚烈眼神。行旅态穿粗布短打、护腕、绑腿、布靴、持梢棒；都头态换深色公服、腰牌、佩刀，但不换脸。",
      "variant_policy": "行旅打虎态、打虎后尘血态、都头公服态只改变服装、尘血和官身标志，不改变脸、身高体量和眼神气质。",
      "forbidden_inheritance": "不得画成俊美小生、仙侠侠客、现代武士、盔甲将军或网红脸；不得丢失高大强壮体态。",
      "notes": "视觉参考可吸收传统戏曲/民间工艺里的武生轮廓：罗帽或头巾、窄袖短衣、颈间领巾、护腕、绑腿、布靴、梢棒。不得像任何影视演员，不复刻具体剧照。",
      "age_variants": {
        "行旅打虎态": "粗布短打、梢棒、酒意未散、山冈尘土。",
        "都头公服态": "深色公服、腰牌、佩刀、姿态端正。"
      },
