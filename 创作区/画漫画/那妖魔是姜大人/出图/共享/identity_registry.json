      "character_dna": "瓜子脸/窄下颌，冷白肤色，黑色长发，额前碎发，眼型细长清冷，琥珀冷光瞳，鼻梁秀挺，唇形克制，气质清冷、危险、克制；参考图里的精致3D国漫脸是脸部基础模版。长期基础定妆体态纤细高挑，黑白水墨仙侠长衣或轻甲裙装，黑纱披帛/水墨衣摆可作为轮廓标志。",
      "dna_contract": "专门定妆多视图 front/three_quarter/side/back/face 是长期基础包：继承用户参考图的脸型、眼型、发际线、发量、黑长发轮廓、冷白肤色和清冷危险气质；全身视图使用干净稳定的黑白水墨仙侠服装，不画囚服、尘土、血污、战损、狼狈破布或剧情动作。第1话穿越初始面板可临时改成灰扑扑囚服和伤污，但必须只改服装/状态，不得换脸、换眼型或换发际线。",
      "variant_policy": "年龄形态继承开启。后续少年/成年、受伤、觉醒、换装、镇魔司黑衣、妖气缠身等形态只改年龄比例、服装层、伤污和特效强度；长期基础定妆始终作为最高优先级脸部与体态锚点，不得换脸、换发际线、换眼型或丢失黑长发轮廓。",
      "forbidden_inheritance": "不继承参考图拼图边框、顶部桥面、平台水印、小红书号、可读文字、纸伞、银色头冠、太极光球、露肩礼服为第1话固定设定；没有剧情要求时不要出现这些元素。",
      "age_variants": {
        "长期基础定妆": {
          "costume": "干净稳定的黑白水墨仙侠长衣或轻甲裙装，黑纱披帛/水墨衣摆，冷白肤色，黑长发，清冷危险气质",
          "must_inherit": "CHAR_JYC face DNA"
        },
        "穿越初始": {
          "costume": "灰扑扑囚服，尘土，少量血污，黑长发凌乱",
          "must_inherit": "CHAR_JYC face DNA"
        },
        "镇魔司误认": {
          "costume": "黑衣赤纹制服可披在外层，脸和发型继承 CHAR_JYC",
          "must_inherit": "CHAR_JYC face DNA"
        }
      },
      "notes": "用户图像是女主脸等基础模版。专门定妆多视图应服务长期一致性，不继承第1话囚服狼狈状态；囚服只作为章节面板状态覆盖。",
      "updated_at": "2026-07-07T13:14:59"
