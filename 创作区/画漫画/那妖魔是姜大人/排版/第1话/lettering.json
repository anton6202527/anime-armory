    {
      "item_id": "L001",
      "panel_id": "P001",
      "type": "narration",
      "speaker": "",
      "text": "风里带着腥气。",
      "text_zh": "风里带着腥气。",
      "slot_id": "B001N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L002",
      "panel_id": "P002",
      "type": "narration",
      "speaker": "",
      "text": "姜月初愣愣地看着眼前的一切。",
      "text_zh": "姜月初愣愣地看着眼前的一切。",
      "slot_id": "B002N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L003",
      "panel_id": "P003",
      "type": "narration",
      "speaker": "",
      "text": "人身，虎头。即便没了声息，凶煞之气仍扑面而来。",
      "text_zh": "人身，虎头。即便没了声息，凶煞之气仍扑面而来。",
      "slot_id": "B003N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L004",
      "panel_id": "P004",
      "type": "dialogue",
      "speaker": "裴长青",
      "text": "过来。",
      "text_zh": "过来。",
      "tone": "沙哑命令",
      "slot_id": "B004D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L005",
      "panel_id": "P005",
      "type": "narration",
      "speaker": "",
      "text": "你说过来就过来？",
      "text_zh": "你说过来就过来？",
      "slot_id": "B005N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
