    {
      "item_id": "L001",
      "panel_id": "P001",
      "type": "narration",
      "speaker": "",
      "text": "刀锋入肉的阻滞，清晰地从掌心传来。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "刀锋入肉的阻滞，清晰地从掌心传来。",
      "slot_id": "B001N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L002",
      "panel_id": "P001",
      "type": "dialogue",
      "speaker": "裴长青",
      "text": "你……",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "你……",
