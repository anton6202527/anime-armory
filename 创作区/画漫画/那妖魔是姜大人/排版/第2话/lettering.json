    },
    {
      "item_id": "L021",
      "panel_id": "P014",
      "type": "narration",
      "speaker": "",
      "text": "身不由己时，已经无所谓忍不忍心。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "身不由己时，已经无所谓忍不忍心。",
