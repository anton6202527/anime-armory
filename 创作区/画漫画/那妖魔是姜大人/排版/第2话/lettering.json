    {
      "item_id": "L019",
      "panel_id": "P013",
      "type": "narration",
      "speaker": "",
      "text": "闻弦初境。猛虎快刀。道行二十五年。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "闻弦初境。猛虎快刀。道行二十五年。",
      "slot_id": "B013N",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L020",
      "panel_id": "P013",
      "type": "dialogue",
      "speaker": "姜月初",
      "text": "原来，这才是道行的真正用法。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "原来，这才是道行的真正用法。",
      "tone": "低声领悟",
      "slot_id": "B013D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
