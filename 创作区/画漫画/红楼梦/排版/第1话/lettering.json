      "type": "narration",
      "speaker": "",
      "text": "盛席华筵，终有散场。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "浮生着甚苦奔忙？盛席华筵终散场。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "盛席华筵，终有散场。",
