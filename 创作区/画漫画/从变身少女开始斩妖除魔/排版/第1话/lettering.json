      "panel_id": "P014",
      "type": "dialogue",
      "speaker": "CHAR_JIANG_YUECHU",
      "text": "往……哪走？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "往……哪走？",
