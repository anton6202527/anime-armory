      "panel_id": "P016",
      "type": "dialogue",
      "speaker": "MON_TIGER_SHANSHEN",
      "text": "很意外么？凭几个不入流的镇魔卫，也想杀我？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "很意外么？凭几个不入流的镇魔卫，也想杀我？",
