      "type": "dialogue",
      "speaker": "CHAR_PEI_CHANGQING",
      "text": "往南。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "往南。",
