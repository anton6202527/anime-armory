    {
      "item_id": "L023",
      "panel_id": "P015",
      "type": "narration",
      "speaker": "",
      "text": "人死不能复生……可没人说过，妖也一样。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "人死不能复生……可没人说过，妖也一样。",
      "slot_id": "B015N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
