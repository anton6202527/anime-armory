    {
      "item_id": "L035",
      "panel_id": "P021",
      "type": "narration",
      "speaker": "",
      "text": "百妖谱……斩杀生物，可得道行。以妖血为墨，可夺其神通。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "百妖谱……斩杀生物，可得道行。以妖血为墨，可夺其神通。",
      "slot_id": "B021N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L036",
      "panel_id": "P022",
