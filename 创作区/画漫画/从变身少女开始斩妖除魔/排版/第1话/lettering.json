    {
      "item_id": "L001",
      "panel_id": "P001",
      "type": "narration",
      "speaker": "",
      "text": "风里带着腥气。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "风里带着腥气。",
      "slot_id": "B001N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L002",
      "panel_id": "P001",
      "type": "sfx",
      "speaker": "",
      "text": "呼——",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "呼——",
      "slot_id": "B001S2",
      "style": {
        "font": "project_default",
        "size": 72,
        "direction": "horizontal",
        "bubble": "none",
        "drawn_lettering_mode": "drawn_sfx",
        "integration": "integrate with action path or impact zone; do not cover face, hands, key props, or final dialogue slots",
        "shape": "match sound quality: jagged for impact, stretched for speed, soft for ambience"
      }
    },
    {
      "item_id": "L003",
      "panel_id": "P002",
      "type": "narration",
      "speaker": "",
      "text": "大唐。妖魔横行。而我……穿成了一个被发配的女人？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "大唐。妖魔横行。而我……穿成了一个被发配的女人？",
      "slot_id": "B002N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L004",
      "panel_id": "P003",
      "type": "narration",
      "speaker": "",
      "text": "这里到底发生了什么？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "这里到底发生了什么？",
      "slot_id": "B003N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L005",
      "panel_id": "P004",
      "type": "narration",
      "speaker": "",
      "text": "是妖魔……还好，已经死了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "是妖魔……还好，已经死了。",
      "slot_id": "B004N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L006",
      "panel_id": "P005",
      "type": "narration",
      "speaker": "",
      "text": "除了我，只剩他还活着。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "除了我，只剩他还活着。",
      "slot_id": "B005N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L007",
      "panel_id": "P006",
      "type": "narration",
      "speaker": "",
      "text": "你说过去就过去？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "你说过去就过去？",
      "slot_id": "B006N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L008",
      "panel_id": "P006",
      "type": "dialogue",
      "speaker": "CHAR_PEI_CHANGQING",
      "text": "过来。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "过来。",
      "tone": "沙哑、不容拒绝",
      "slot_id": "B006D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L009",
      "panel_id": "P007",
      "type": "narration",
      "speaker": "",
      "text": "罪官之女，没入贱籍。而他是镇魔司的人。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "罪官之女，没入贱籍。而他是镇魔司的人。",
      "slot_id": "B007N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L010",
      "panel_id": "P008",
      "type": "narration",
      "speaker": "",
      "text": "趁他快死了，跑。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "趁他快死了，跑。",
      "slot_id": "B008N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L011",
      "panel_id": "P008",
      "type": "sfx",
      "speaker": "",
      "text": "咻！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "咻！",
      "slot_id": "B008S2",
      "style": {
        "font": "project_default",
        "size": 72,
        "direction": "horizontal",
        "bubble": "none",
        "drawn_lettering_mode": "drawn_sfx",
        "integration": "integrate with action path or impact zone; do not cover face, hands, key props, or final dialogue slots",
        "shape": "match sound quality: jagged for impact, stretched for speed, soft for ambience"
      }
    },
    {
      "item_id": "L012",
      "panel_id": "P008",
      "type": "sfx",
      "speaker": "",
      "text": "笃！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "笃！",
      "slot_id": "B008S2",
      "style": {
        "font": "project_default",
        "size": 72,
        "direction": "horizontal",
        "bubble": "none",
        "drawn_lettering_mode": "drawn_sfx",
        "integration": "integrate with action path or impact zone; do not cover face, hands, key props, or final dialogue slots",
        "shape": "match sound quality: jagged for impact, stretched for speed, soft for ambience"
      }
    },
    {
      "item_id": "L013",
      "panel_id": "P009",
      "type": "narration",
      "speaker": "",
      "text": "好猛的将死之人……罢了，过来就过来。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "好猛的将死之人……罢了，过来就过来。",
      "slot_id": "B009N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L014",
      "panel_id": "P011",
      "type": "dialogue",
      "speaker": "CHAR_PEI_CHANGQING",
      "text": "扶我起来。在下裴长青，陇右镇魔都司队正。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "扶我起来。在下裴长青，陇右镇魔都司队正。",
      "tone": "强撑、示诚",
      "slot_id": "B011D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L015",
      "panel_id": "P012",
      "type": "narration",
      "speaker": "",
      "text": "画大饼画到我头上了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "画大饼画到我头上了。",
      "slot_id": "B012N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L016",
      "panel_id": "P012",
      "type": "dialogue",
      "speaker": "CHAR_PEI_CHANGQING",
      "text": "没有户籍路引，你逃到下一座城又能如何？按我说的做，我保你自由。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "没有户籍路引，你逃到下一座城又能如何？按我说的做，我保你自由。",
      "tone": "审视、诱导",
      "slot_id": "B012D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L017",
      "panel_id": "P013",
      "type": "narration",
      "speaker": "",
      "text": "他说得没错。一个没有身份的弱女子，根本活不出这片荒野。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "他说得没错。一个没有身份的弱女子，根本活不出这片荒野。",
      "slot_id": "B013N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L018",
      "panel_id": "P013",
      "type": "dialogue",
      "speaker": "CHAR_JIANG_YUECHU",
      "text": "……好。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "……好。",
      "tone": "不甘、理性妥协",
      "slot_id": "B013D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L019",
      "panel_id": "P014",
      "type": "narration",
      "speaker": "",
      "text": "好沉！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "好沉！",
      "slot_id": "B014N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
