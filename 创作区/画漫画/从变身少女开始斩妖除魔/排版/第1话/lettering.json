      "panel_id": "P020",
      "type": "dialogue",
      "speaker": "MON_TIGER_SHANSHEN",
      "text": "人身多苦厄，早些解脱岂不美哉？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "人身多苦厄，早些解脱岂不美哉？",
      "tone": "伪善、戏弄",
      "slot_id": "B020D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
