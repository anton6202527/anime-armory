    {
      "item_id": "L033",
      "panel_id": "P020",
      "type": "narration",
      "speaker": "",
      "text": "刚穿越几分钟，就要死在这里？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "刚穿越几分钟，就要死在这里？",
