      "panel_id": "P020",
      "type": "dialogue",
      "speaker": "王进",
      "text": "脱了天罗地网，延安不远了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "脱了天罗地网，延安不远了。",
