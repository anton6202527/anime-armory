    {
      "item_id": "L008",
      "panel_id": "P012",
      "type": "narration",
      "speaker": "",
      "text": "这一去，便成逃军。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S040：王進自去備了馬，牽出後槽，將料袋袱駝搭上，把索子拴縛牢了，牽在後門外，扶娘上了馬。家中粗重都棄了，鎖上前後門，挑了擔兒，跟在馬後。趁五更天色未明，乘勢出了西華門，取路望延安府來。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "这一去，便成逃军。",
      "slot_id": "B012N1",
      "style": {
