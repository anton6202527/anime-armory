    {
      "item_id": "L022",
      "panel_id": "P031",
      "type": "dialogue",
      "speaker": "端王",
      "text": "这对玉狮，温润有趣。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "这对玉狮，温润有趣。",
      "tone": "喜爱",
      "slot_id": "B031D1",
      "style": {
        "font": "project_default",
