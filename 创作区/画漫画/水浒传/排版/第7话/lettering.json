      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "请全村庄户来草堂议事。",
      "tone": "",
      "slot_id": "B008D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
