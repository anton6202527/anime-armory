      "type": "dialogue",
      "speaker": "SHI_JIN",
      "text": "宁同死，不卖友。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "宁同死，不卖友。",
