    {
      "item_id": "L005",
      "panel_id": "P005",
      "type": "dialogue",
      "speaker": "LI_JI",
      "text": "原告李吉在此，回书便是铁证！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "原告李吉在此，回书便是铁证！",
