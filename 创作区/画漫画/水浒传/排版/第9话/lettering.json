    {
      "item_id": "L002",
      "panel_id": "P002",
      "type": "dialogue",
      "speaker": "SHI_JIN",
      "text": "把我们绑出去，保全大郎。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "把我们绑出去，保全大郎。",
