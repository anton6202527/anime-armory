    {
      "item_id": "L003",
      "panel_id": "P003",
      "type": "dialogue",
      "speaker": "SHI_JIN",
      "text": "我若死，与你们同死；活，便同活。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "我若死，与你们同死；活，便同活。",
