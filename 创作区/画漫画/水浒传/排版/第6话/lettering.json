    {
      "item_id": "L029",
      "panel_id": "P035",
      "type": "narration",
      "speaker": "",
      "text": "十里，无一句闲话。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S064：史進並太公苦留不住，只得安排一個筵席送行。托出一盤兩個緞子，一百兩花銀謝師。次日，王進收拾了擔兒，備了馬，子母二人，相辭史太公。王進請娘乘了馬，望延安府路途進發。史進叫莊客挑了擔兒，親送十里之程，心中難捨。史進當時拜別了師父，灑淚分手，和莊客自回。王教頭依舊自挑了擔兒，跟著馬，和娘兩個，自取關西路裏去了。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "十里，无一句闲话。",
      "slot_id": "B035N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L030",
      "panel_id": "P036",
      "type": "dialogue",
      "speaker": "王进",
      "text": "到这里吧。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "到这里吧。",
      "tone": "",
      "slot_id": "B036D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
