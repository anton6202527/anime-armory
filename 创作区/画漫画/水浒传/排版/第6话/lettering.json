    {
      "item_id": "L015",
      "panel_id": "P019",
      "type": "narration",
      "speaker": "",
      "text": "春去。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S060：話說這史進每日在莊上管待王教頭母子二人，指教武藝。史太公自去華陰縣中承當里正，不在話下。不覺荏苒光陰，早過半年之上，正是：",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "春去。",
      "slot_id": "B019N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L016",
      "panel_id": "P020",
      "type": "narration",
      "speaker": "",
      "text": "日影弹指。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S061：窗外日光彈指過，席間花影坐前移。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "日影弹指。",
      "slot_id": "B020N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L017",
      "panel_id": "P021",
      "type": "narration",
      "speaker": "",
      "text": "半载将满。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S062：一杯未進笙歌送，階下辰牌又報時。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "半载将满。",
      "slot_id": "B021N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
