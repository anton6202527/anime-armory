    {
      "item_id": "L029",
      "panel_id": "P030",
      "type": "narration",
      "speaker": "",
      "text": "可魔君，已经不在了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S008：當時洪太尉聽罷，渾身冷汗，捉顫不住。急急收拾行李，引了從人，下山回京。真人並道眾送官已罷，自回宮內，修整殿宇，起豎石碑，不在話下。",
