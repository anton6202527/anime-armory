    {
      "item_id": "L024",
      "panel_id": "P025",
      "type": "narration",
      "speaker": "",
      "text": "天未明，他便要走。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S008：當時洪太尉聽罷，渾身冷汗，捉顫不住。急急收拾行李，引了從人，下山回京。真人並道眾送官已罷，自回宮內，修整殿宇，起豎石碑，不在話下。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "天未明，他便要走。",
      "slot_id": "B025N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
