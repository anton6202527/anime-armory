    {
      "item_id": "L003",
      "panel_id": "P004",
      "type": "dialogue",
      "speaker": "住持",
      "text": "当年，洞玄真人传下法符。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "当年，洞玄真人传下法符。",
      "tone": "画外沉痛",
      "slot_id": "B004D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L004",
      "panel_id": "P005",
      "type": "dialogue",
      "speaker": "住持",
      "text": "石碑、天符，镇守幽扃。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "石碑、天符，镇守幽扃。",
      "tone": "画外沉痛",
      "slot_id": "B005D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L005",
      "panel_id": "P006",
      "type": "dialogue",
      "speaker": "住持",
      "text": "殿中镇着——",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "殿中镇着——",
      "tone": "画外压低",
      "slot_id": "B006D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
