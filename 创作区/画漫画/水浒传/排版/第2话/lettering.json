    {
      "item_id": "L030",
      "panel_id": "P031",
      "type": "narration",
      "speaker": "",
      "text": "洪信星夜回京。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S009：再說洪太尉在途中吩咐從人，教把走妖魔一節，休說與外人知道，恐天子知而見責。於路無話，星夜回至京師，進得汴梁城，聞人所說：「天師在東京禁院做了七晝夜好事，普施符籙，禳救災病，瘟疫盡消，軍民安泰。天師辭朝",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "洪信星夜回京。",
      "slot_id": "B031N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
