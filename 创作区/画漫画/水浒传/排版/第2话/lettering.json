      "panel_id": "P012",
      "type": "dialogue",
      "speaker": "住持",
      "text": "如今，都叫太尉放走了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "如今，都叫太尉放走了。",
