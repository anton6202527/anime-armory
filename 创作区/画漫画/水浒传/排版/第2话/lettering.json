    {
      "item_id": "L012",
      "panel_id": "P012",
      "type": "dialogue",
      "speaker": "住持",
      "text": "怎生是好？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "怎生是好？",
      "tone": "质问",
      "slot_id": "B012D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
