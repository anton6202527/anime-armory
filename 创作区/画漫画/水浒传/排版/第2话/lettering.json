    {
      "item_id": "L013",
      "panel_id": "P013",
      "type": "narration",
      "speaker": "",
      "text": "千古幽扃，一旦洞开。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S004：千古幽扃一旦開，天罡地煞出泉臺。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "千古幽扃，一旦洞开。",
      "slot_id": "B013N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L014",
      "panel_id": "P014",
      "type": "narration",
      "speaker": "",
      "text": "本为禳灾，却又惹灾。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S005：自來無事多生事，本為禳災卻惹災。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "本为禳灾，却又惹灾。",
      "slot_id": "B014N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L015",
      "panel_id": "P015",
      "type": "narration",
      "speaker": "",
      "text": "自此，云扰社稷。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S006：社稷從今雲擾擾，兵戈到處鬧垓垓。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "自此，云扰社稷。",
      "slot_id": "B015N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
