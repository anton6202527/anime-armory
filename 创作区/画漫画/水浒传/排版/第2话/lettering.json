      "panel_id": "P032",
      "type": "dialogue",
      "speaker": "洪信",
      "text": "记住。一个字，也不许漏。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "记住。一个字，也不许漏。",
