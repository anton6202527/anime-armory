    {
      "item_id": "L001",
      "panel_id": "P002",
      "type": "narration",
      "speaker": "",
      "text": "太原王生，早行遇一女郎。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S002：王生早行遇女，邀入敝庐。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "太原王生，早行遇一女郎。",
      "slot_id": "B002N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L002",
      "panel_id": "P002",
      "type": "dialogue",
      "speaker": "少女",
      "text": "我无处可去。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "我无处可去。",
      "tone": "",
      "slot_id": "B002D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L003",
      "panel_id": "P002",
      "type": "dialogue",
      "speaker": "王生",
      "text": "敝庐不远。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "敝庐不远。",
      "tone": "",
      "slot_id": "B002D3",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L004",
      "panel_id": "P003",
      "type": "dialogue",
      "speaker": "陈氏",
      "text": "她来历不明，请你遣走她。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "她来历不明，请你遣走她。",
      "tone": "",
      "slot_id": "B003D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L005",
      "panel_id": "P003",
      "type": "dialogue",
      "speaker": "王生",
      "text": "你多心了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "你多心了。",
      "tone": "",
      "slot_id": "B003D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L006",
      "panel_id": "P004",
      "type": "dialogue",
      "speaker": "道士",
      "text": "君身邪气萦绕。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "君身邪气萦绕。",
      "tone": "",
      "slot_id": "B004D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L007",
      "panel_id": "P004",
      "type": "dialogue",
      "speaker": "道士",
      "text": "惑哉！死将临而不悟。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "惑哉！死将临而不悟。",
      "tone": "",
      "slot_id": "B004D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L008",
      "panel_id": "P005",
      "type": "narration",
      "speaker": "",
      "text": "那张脸——是画上去的。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S003：王生窗窥，见狞鬼画人皮而披之成女。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "那张脸——是画上去的。",
      "slot_id": "B005N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L009",
      "panel_id": "P006",
      "type": "dialogue",
      "speaker": "道士",
      "text": "挂在寝门。她若肯退，我便不伤她。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "挂在寝门。她若肯退，我便不伤她。",
      "tone": "",
      "slot_id": "B006D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L010",
      "panel_id": "P007",
      "type": "dialogue",
      "speaker": "画皮鬼",
      "text": "道士吓我？你的心，我取定了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "道士吓我？你的心，我取定了。",
      "tone": "",
      "slot_id": "B007D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L011",
      "panel_id": "P007",
      "type": "sfx",
      "speaker": "",
      "text": "喀嚇！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "喀嚇！",
      "slot_id": "B007S2",
      "style": {
        "font": "project_default",
        "size": 72,
        "direction": "horizontal",
        "bubble": "none",
        "drawn_lettering_mode": "drawn_sfx",
        "integration": "integrate with action path or impact zone; do not cover face, hands, key props, or final dialogue slots",
