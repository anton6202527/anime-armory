    },
    {
      "item_id": "L012",
      "panel_id": "P008",
      "type": "narration",
      "speaker": "",
      "text": "天亮时，王生已没了心。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S004：鬼裂生腹，掬生心而去。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "天亮时，王生已没了心。",
      "slot_id": "B008N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L013",
      "panel_id": "P009",
      "type": "dialogue",
      "speaker": "道士",
      "text": "孽魅！偿我拂子来！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "孽魅！偿我拂子来！",
      "tone": "",
      "slot_id": "B009D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L014",
      "panel_id": "P009",
      "type": "sfx",
      "speaker": "",
      "text": "呼——",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "呼——",
      "slot_id": "B009S2",
      "style": {
        "font": "project_default",
        "size": 72,
        "direction": "horizontal",
        "bubble": "none",
        "drawn_lettering_mode": "drawn_sfx",
        "integration": "integrate with action path or impact zone; do not cover face, hands, key props, or final dialogue slots",
        "shape": "match sound quality: jagged for impact, stretched for speed, soft for ambience"
      }
    },
    {
      "item_id": "L015",
      "panel_id": "P010",
      "type": "dialogue",
      "speaker": "道士",
      "text": "我救不活他。去求市上那个疯子。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "我救不活他。去求市上那个疯子。",
      "tone": "",
      "slot_id": "B010D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L016",
      "panel_id": "P010",
      "type": "dialogue",
      "speaker": "道士",
      "text": "他若辱你，勿怒。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "他若辱你，勿怒。",
      "tone": "",
      "slot_id": "B010D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L017",
      "panel_id": "P011",
      "type": "dialogue",
      "speaker": "疯乞",
      "text": "人尽夫也，活之何为？",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "人尽夫也，活之何为？",
      "tone": "",
      "slot_id": "B011D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L018",
      "panel_id": "P011",
      "type": "dialogue",
      "speaker": "疯乞",
      "text": "食之！",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "食之！",
      "tone": "",
      "slot_id": "B011D2",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
    },
    {
      "item_id": "L019",
      "panel_id": "P012",
      "type": "narration",
      "speaker": "",
      "text": "我带回来的，只有这一身羞。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S007：陈抱尸收肠，且理且哭。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "我带回来的，只有这一身羞。",
      "slot_id": "B012N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
    },
    {
      "item_id": "L020",
      "panel_id": "P013",
      "type": "narration",
      "speaker": "",
      "text": "一颗心——在跳。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S007：陈氏哭极欲呕，结物落腔中，乃人心也，突突犹跃。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "一颗心——在跳。",
      "slot_id": "B013N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
