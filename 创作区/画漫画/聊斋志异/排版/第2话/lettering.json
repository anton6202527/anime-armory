      "type": "narration",
      "speaker": "",
      "text": "找到你了。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S005：儿在市中认出长鬣人，暗中尾随。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "找到你了。",
      "slot_id": "B011N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
