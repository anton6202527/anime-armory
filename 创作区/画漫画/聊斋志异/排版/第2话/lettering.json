    {
      "item_id": "L021",
      "panel_id": "P013",
      "type": "dialogue",
      "speaker": "狐仆",
      "text": "两位主人，一个去北郭，一个就在你家。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "两位主人，一个去北郭，一个就在你家。",
      "tone": "",
      "slot_id": "B013D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
