    {
      "item_id": "L009",
      "panel_id": "P006",
      "type": "narration",
      "speaker": "",
      "text": "医药与驱禳，都只能换来几日安稳。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S003：贾人归，医药渐安；一夜妇复奔他室，扃门亦自开。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "医药与驱禳，都只能换来几日安稳。",
      "slot_id": "B006N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
