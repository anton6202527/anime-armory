      "panel_id": "P016",
      "type": "dialogue",
      "speaker": "贾儿",
      "text": "此物最灵，一泄便知。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "此物最灵，一泄便知。",
