    {
      "item_id": "L002",
      "panel_id": "P002",
      "type": "narration",
      "speaker": "",
      "text": "父亲离家经商后，母亲每到夜里就像变了一个人。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S002：父亲外出经商，妇人夜间受狐祟。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "父亲离家经商后，母亲每到夜里就像变了一个人。",
      "slot_id": "B002N1",
      "style": {
