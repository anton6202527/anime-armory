      "panel_id": "P014",
      "type": "dialogue",
      "speaker": "贾儿",
      "text": "酒，我请你。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "酒，我请你。",
      "tone": "",
