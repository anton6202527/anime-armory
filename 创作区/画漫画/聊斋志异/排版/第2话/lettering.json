      "type": "dialogue",
      "speaker": "贾儿",
      "text": "我胡氏之子，世居山洞。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "我胡氏之子，世居山洞。",
