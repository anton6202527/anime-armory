      "item_id": "L020",
      "panel_id": "P012",
      "type": "dialogue",
      "speaker": "贾儿",
      "text": "我辈混在人间，只恨这尾巴藏不住。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_zh": "我辈混在人间，只恨这尾巴藏不住。",
      "tone": "",
      "slot_id": "B012D1",
      "style": {
        "font": "project_default",
        "size": 44,
        "direction": "horizontal",
        "bubble": "round"
      }
