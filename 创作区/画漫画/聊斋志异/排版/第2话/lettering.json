      "item_id": "L024",
      "panel_id": "P016",
      "type": "narration",
      "speaker": "",
      "text": "后来，他果然成了将军。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S006：父称儿为讨狐之陈平，教之骑射，后贵至总戎。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "后来，他果然成了将军。",
      "slot_id": "B016N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
