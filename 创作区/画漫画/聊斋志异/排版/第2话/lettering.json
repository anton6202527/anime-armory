    {
      "item_id": "L023",
      "panel_id": "P015",
      "type": "narration",
      "speaker": "",
      "text": "那一夜，母亲终于安睡。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S006：母安寝；父子至园，见两狐毙亭上、一狐死草中，且有秃尾刀痕。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "那一夜，母亲终于安睡。",
      "slot_id": "B015N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
