    {
      "item_id": "L008",
      "panel_id": "P005",
      "type": "narration",
      "speaker": "",
      "text": "只差一点……但它会流血。",
      "lang": "zh-Hans",
      "dir": "ltr",
      "script": "Hans",
      "line_break": "cjk",
      "text_source": "S003：血迹逾垣而去，入何氏园。",
      "source_lang": "und",
      "source_dir": "ltr",
      "text_zh": "只差一点……但它会流血。",
      "slot_id": "B005N1",
      "style": {
        "font": "project_default",
        "size": 42,
        "direction": "horizontal",
        "bubble": "caption"
      }
