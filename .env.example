# Public client configuration. These values may be bundled into a client.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
ASSET_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/assets

# Server/Edge Function secrets. Never expose these in VITE_*, NEXT_PUBLIC_*,
# Electron renderer code, a desktop package, or source control.
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=anime-armory-private-dev

# Comma-separated browser origins accepted by the Edge Function. Add the
# production Web origin before launch. Native/server requests send no Origin.
ASSET_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSET_SIGNED_URL_TTL_SECONDS=900
ASSET_UPLOAD_SESSION_TTL_SECONDS=86400
ASSET_SINGLE_UPLOAD_LIMIT_BYTES=104857600
ASSET_MULTIPART_PART_SIZE_BYTES=33554432
ASSET_MAX_BYTES=53687091200
ASSET_ACCOUNT_MAX_RESERVED_BYTES=21474836480
ASSET_MAX_ACTIVE_UPLOADS_PER_ACCOUNT=5
