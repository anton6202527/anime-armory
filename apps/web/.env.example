# Public browser configuration. These values identify public endpoints; they are not provider secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_ASSET_API_URL=https://your-project.supabase.co/functions/v1/assets
VITE_AGENT_API_URL=https://api.example.com

# Never put service-role/object-store/model secrets in VITE_* variables.
# For local `vite` development only, copy one of these server-side pairs into
# apps/web/.env.local (without the VITE_ prefix). Vite reads them in its Node
# middleware but does not expose them to browser code:
# CLI_PROXY_API_URL=http://127.0.0.1:8317
# CLI_PROXY_API_KEY=replace_with_your_local_proxy_key
# CUSTOM_OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# CUSTOM_OPENAI_API_KEY=replace_with_your_local_proxy_key
