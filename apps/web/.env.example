# Public browser configuration. These values identify public endpoints; they are not provider secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_ASSET_API_URL=https://your-project.supabase.co/functions/v1/assets
VITE_AGENT_API_URL=https://api.example.com

# Never put any of the following in this file or in VITE_* variables:
# SUPABASE_SERVICE_ROLE_KEY, R2_SECRET_ACCESS_KEY, or a multimodal provider API key.
