# Desktop main-process configuration. Never commit a real API key.
CLI_PROXY_API_URL=http://127.0.0.1:8317
CLI_PROXY_API_KEY=replace_with_your_local_proxy_key
# Compatible aliases (use either pair, not both):
# CUSTOM_OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# CUSTOM_OPENAI_API_KEY=replace_with_your_local_proxy_key

# Comma-separated production Web origins allowed to pair with the loopback bridge.
ANIME_ARMORY_WEB_ORIGINS=https://labutv.example.com
