{
  "name": "@anime-armory/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Electron + React desktop IDE for the LabuTV creative production platform.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/prepare-dev-brand.cjs && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "node scripts/prepare-dev-brand.cjs && electron-vite preview",
    "icon:render": "electron scripts/render-app-icon.mjs",
    "postinstall": "electron-rebuild -f -w node-pty && node scripts/fix-pty-prebuilds.cjs",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dompurify": "3.4.12",
    "extract-zip": "^2.0.1",
    "node-pty": "^1.1.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.3.5",
    "electron": "43.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "monaco-editor": "0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.4"
  }
}
