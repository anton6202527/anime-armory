# Loopback REST server. Keep BACKEND_HOST on a loopback address during local development.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=43118
BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174

# Supabase public project coordinates used by the BFF auth proxy. The browser
# does not receive either value or store access/refresh tokens in JavaScript.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# OpenAI-compatible cliproxy service. Never prefix API keys with VITE_.
CLI_PROXY_API_URL=http://127.0.0.1:8317
# CLI_PROXY_API_KEY=

# Optional safety limits.
BACKEND_MAX_BODY_BYTES=18874368
BACKEND_MAX_UPLOAD_BYTES=12582912
BACKEND_MAX_CONCURRENT_GENERATIONS=3
BACKEND_MAX_REQUESTS_PER_MINUTE=120
