# Local Supabase Edge Function secrets.
# Copy this file to .env.local; never commit .env.local.

# API-key text providers. These names match the server-side adapters shared with AniCode.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
GEMINI_API_KEY=replace_with_your_gemini_api_key
# GOOGLE_API_KEY is accepted as a Gemini fallback when GEMINI_API_KEY is absent.
GOOGLE_API_KEY=

# Optional endpoint overrides for compatible gateways.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Other multimodal providers remain behind the cloud Agent API.
MULTIMODAL_API_KEY=replace_with_your_api_key

# Cloudflare R2 server-side credentials.
R2_ACCOUNT_ID=replace_with_your_account_id
R2_ACCESS_KEY_ID=replace_with_your_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_your_secret_access_key
R2_BUCKET=replace_with_your_private_bucket_name

# Supabase server-only key used by Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
