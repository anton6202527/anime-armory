# Local Supabase Edge Function secrets.
# Copy this file to .env.local; never commit .env.local.

# Multimodal model provider (the exact variable name may be specialized after the provider is selected).
MULTIMODAL_API_KEY=replace_with_your_api_key

# Cloudflare R2 server-side credentials.
R2_ACCOUNT_ID=replace_with_your_account_id
R2_ACCESS_KEY_ID=replace_with_your_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_your_secret_access_key
R2_BUCKET=replace_with_your_private_bucket_name

# Supabase server-only key used by Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
